---
import Shell from '../layouts/Shell.astro';
import { Content, frontmatter } from '../content/about.md';
import '../styles/body.css';

const title = frontmatter.title;
// 연락처 아이콘은 이 페이지 본문에 두지 않는다. 바로 아래 바닥글에 같은 줄이 있어 연달아 두 번 보인다.
---
<Shell title={title} description={frontmatter.summary} path="/about/" pageType="AboutPage">
  <article class="wrap wiki-about">
    <h1 class="display">{title}</h1>
    <div class="body intro-body"><Content /></div>
  </article>
</Shell>
<style>
  .wiki-about { max-width: var(--s-reader-column); padding-top: var(--s-page-top-reading); padding-bottom: var(--s-page-bottom); }
  h1 { margin: 0 0 32px; font-size: var(--t-title); line-height: 1.3; letter-spacing: -.03em; text-wrap: balance; }
  .intro-body { line-height: 1.85; }
  .intro-body :global(h2) { margin: 44px 0 18px; font-size: var(--t-h2); line-height: 1.4; }
  .intro-body :global(p) { margin: 0 0 18px; }
  .intro-body :global(a) { text-decoration: underline; text-underline-offset: 4px; }
</style>
