---
import Shell from '../../layouts/Shell.astro';
import BookCard from '../../components/BookCard.astro';
import { getGarden } from '../../lib/get-garden.ts';
import { statusFilters } from '../../lib/books.ts';
const { books } = await getGarden();
const tiers = ['S', 'A', 'B', 'C', 'D', '미분류'].map((tier) => ({ tier, books: books.filter((b) => b.tier === tier) })).filter((t) => t.books.length);
const filters = statusFilters(books);
---
<Shell title="책장" description="읽은 책과 한 줄 평." path="/books/" active="books">
  <div class="wrap books-page">
    <div class="page-head"><h1 class="display">책장</h1>
      <nav class="status-filter meta" aria-label="읽기 상태">{filters.map((f) => <button type="button" data-book-status={f.value} aria-pressed={f.value === 'all'}>{f.label} <span class="count">{f.count}</span></button>)}</nav>
    </div>
    {tiers.map((t) => <section class:list={['ledger-group', { unrated: t.tier === '미분류' }]} data-tier>
      <div class="ledger-head"><h2 class:list={['display', { 'unrated': t.tier === '미분류' }]}>{t.tier}</h2><span class="meta" data-tier-count>{t.books.length}권</span></div>
      <div class="grid">{t.books.map((book) => <BookCard book={book} />)}</div>
    </section>)}
    <p class="book-source meta">도서 정보·표지 출처: <a href="https://www.yes24.com" target="_blank" rel="noreferrer">YES24 ↗</a></p>
  </div>
</Shell>
<style>
  .books-page { padding: var(--s-page-top-index) 0 var(--s-page-bottom); }
  .page-head { flex-wrap: wrap; gap: 8px 20px; }
  .book-source { margin: 20px 0 0; color: var(--muted); text-align: right; }
  .book-source a { color: inherit; }
  /* 거르개는 지도 범례와 같은 방식이다. 누른 것 하나만 aria-pressed로 남는다. */
  .status-filter { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 4px; margin-left: auto; }
  .status-filter button { position: relative; padding: 4px 7px; border: 0; border-radius: 4px; background: transparent; color: var(--muted); font: inherit; cursor: pointer; transition: background-color .15s ease, color .15s ease; }
  /* 선택은 헤더의 현재 메뉴와 같이 글자 폭만큼 얹은 2px 먹색 막대로 표시한다. 판으로 표시하면 호버 판과 1.10:1,
     한 단계 짙은 구분선 색으로도 종이색과 1.28:1이라 무엇이 눌렸는지 보이지 않는다. 막대는 먹색이라 13:1이다. */
  .status-filter button[aria-pressed="true"] { color: var(--accent); }
  .status-filter button[aria-pressed="true"]::after { position: absolute; right: 7px; bottom: 0; left: 7px; height: 2px; background: var(--accent); content: ""; }
  @media (hover: hover) { .status-filter button:hover { background: var(--accent-soft); color: var(--accent); } }
  .status-filter .count { color: var(--muted); font-variant-numeric: tabular-nums; }
  .status-filter button[aria-pressed="true"] .count { color: inherit; }
  /* 등급 묶음은 공용 장부(.ledger-group)를 쓰고 여백과 굵기만 다르다. */
  .books-page .ledger-group { padding-bottom: 28px; }
  /* 등급은 한 글자라 62px 칸에 들어가지만 미분류는 세 글자다. 글자를 200%로 키우면 글자 폭이 98px이 되어
     칸을 넘어 책 격자를 12px 덮는다. 요소 상자는 62px 그대로라 겹침이 상자 계산에 잡히지 않는다.
     이 묶음만 칸이 글자를 따라 넓어지게 둔다. 보통 크기에서는 49px이라 62px 그대로여서 다른 묶음과 나란히 선다.
     한 열로 바뀌는 720px 이하는 칸이 하나뿐이라 걸지 않는다. */
  @media (min-width: 721px) {
    .books-page .ledger-group.unrated { grid-template-columns: minmax(62px, max-content) minmax(0, 1fr); }
  }
  .books-page .ledger-head h2.unrated { font-size: var(--t-ledger-word); line-height: 1.4; white-space: nowrap; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 40px; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .page-head { gap: 12px; } .book-source { font-size: var(--t-micro); } }
  @media (pointer: coarse) { .status-filter button { min-height: 44px; } }
</style>
<script src="../../scripts/books.ts"></script>
