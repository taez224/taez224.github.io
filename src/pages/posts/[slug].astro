---
import { getCollection } from 'astro:content';
import NotePage from '../../components/NotePage.astro';
import ExternalArticle from '../../components/ExternalArticle.astro';
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.kind === 'blog');
  return notes.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
{entry.data.contentMode === 'external' ? <ExternalArticle entry={entry} /> : <NotePage entry={entry} />}
