---
import Shell from '../layouts/Shell.astro';
import { withBase } from '../lib/format.mjs';
---
<Shell title="찾을 수 없는 페이지" description="주소가 바뀌었거나 공개되지 않은 노트입니다." path="/404/">
  <section class="wrap" style="padding: 96px 0;">
    <h1 class="display" style="font-size: 28px;">찾을 수 없는 페이지</h1>
    <p style="color: var(--muted); max-width: 32em;">주소가 바뀌었거나 공개되지 않은 노트입니다. 노트 지도에서 다시 찾거나 검색을 써 보세요.</p>
    <div style="display: flex; gap: 20px; margin-top: 24px;"><a class="btn" href={withBase('/map/')}>노트 지도 열기</a><a href={withBase('/')} style="align-self: center;">홈으로</a></div>
  </section>
</Shell>
