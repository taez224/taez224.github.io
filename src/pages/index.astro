---
import Shell from '../layouts/Shell.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import '../styles/graph.css';
import About from '../components/About.astro';
import { getGarden } from '../lib/get-garden.mjs';
import { formatDate, withBase, firstSentence } from '../lib/format.mjs';
import { parentLink } from '../lib/note-nav.mjs';
import { latestSeries } from '../lib/blog.mjs';
import { kindPrefix } from '../lib/slug.mjs';
import { layoutGraph, ATLAS_LAYOUT } from '../graph/layout.mjs';
import { renderSnapshotSvg } from '../graph/snapshot.mjs';
const garden = await getGarden();
const byPath = new Map(garden.notes.map((n) => [n.path, n]));
const entry = byPath.get(garden.config.entry);
const featured = byPath.get(garden.home.featured[0]);
const featuredEntry = featured ? await getEntry('notes', `${kindPrefix(featured.kind)}/${featured.slug}`) : null;
const thumbnail = featuredEntry?.data.thumbnail;
const softThumbnail = featured?.thumbnailStyle === 'soft';
// 최근 기록은 종류마다 최신 한 편. 한 종류를 하루에 몰아 올려도 다른 종류가 목록에서 밀리지 않는다. 대표 글은 후보에서 뺀다.
// 연재의 각 편은 여기 넣지 않는다. 새 편이 나올 때마다 아래 최근 연재와 같은 연재를 두 번 가리키게 된다.
const HOME_KINDS = [['slipbox', '노트'], ['development', '개발 노트'], ['blog', '글']];
const seriesPaths = new Set(garden.blog.series.flatMap((s) => s.posts.map((post) => post.path)));
const dated = garden.notes.filter((n) => n.date && n.type !== 'series' && !seriesPaths.has(n.path) && n.path !== featured?.path).sort((a, b) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title, 'ko'));
const recent = HOME_KINDS.map(([kind, label]) => { const note = dated.find((n) => n.kind === kind); return note && { note, label, listUrl: withBase(parentLink(note).path) }; }).filter(Boolean).sort((a, b) => b.note.date.localeCompare(a.note.date));
// 공개된 마지막 편이 가장 최근인 연재 하나. 없으면 이 영역을 그리지 않는다.
const series = latestSeries(garden.blog.series);
const seriesUrl = series && (series.noteUrl || series.posts[0]?.url);
// 모바일 홈의 정적 지도. <img>가 아니라 인라인이라 영역 이름에 페이지 서체가 적용된다. 데스크톱은 hero.js가 살아 있는 지도로 바꾼다.
const snapshot = renderSnapshotSvg(garden.nodes, garden.edges, layoutGraph(garden.nodes, garden.edges, { width: 1000, height: 640, ...ATLAS_LAYOUT }), { width: 1000, height: 640, font: 26, regionFont: 30, strokeWidth: 2, label: `생각 지도. 노드 ${garden.stats.nodes}개와 연결 ${garden.stats.edges}개.` });
---
<Shell title="TaeZ" description={garden.home.about} path="/">
  <section class="hero" aria-label="소개와 생각 지도">
    <div class="hero-about"><About about={garden.home.about} contacts={garden.home.contacts} entryUrl={entry?.url ?? withBase('/map/')} aboutUrl={withBase('/about/')} /></div>
    <div class="hero-graph" data-graph data-site={withBase('/data/site.json')}><a class="hero-snapshot" href={withBase('/map/')} aria-label="생각 지도 열기"><Fragment set:html={snapshot} /></a></div>
    <div class="hero-fade" aria-hidden="true"></div>
  </section>
  {/* 대표 글 썸네일은 데스크톱 첫 화면 안에 있다. lazy로 두면 LCP 후보가 늦게 시작한다. */}
  {featured && <section class:list={['wrap', 'featured', { 'has-thumbnail': thumbnail }]}>
    <div class="featured-copy">
      <div class="meta">대표 글 · {formatDate(featured.date)}{featured.publication && <> · {featured.publication} 발행</>}</div>
      <h2 class="display"><a href={featured.url}>{featured.title}</a></h2>
      {featured.summaryIsExplicit && <p>{firstSentence(featured.summary)}</p>}
    </div>
    {thumbnail && <a class:list={['featured-image', { 'is-soft': softThumbnail }]} href={featured.url} aria-label={featured.title}>
      <Image src={thumbnail} alt="" width={560} widths={[280, 560, 840]} sizes={`(max-width: 460px) calc(100vw - 40px), (max-width: 720px) 420px, ${softThumbnail ? 312 : 280}px`} format="webp" loading="eager" fetchpriority="high" />
    </a>}
  </section>}
  <section class="wrap recent" aria-labelledby="recent-heading">
    <h2 id="recent-heading" class="display">최근 기록</h2>
    <ol>{recent.map(({ note, label, listUrl }) => <li><time class="meta" datetime={note.date}>{formatDate(note.date)}</time><a href={note.url}>{note.type === 'hub' && <i class="hub-mark" aria-hidden="true"></i>}{note.title}</a><a class="meta kind" href={listUrl}>{label}</a></li>)}</ol>
  </section>
  {series && seriesUrl && <section class="wrap latest-series" aria-labelledby="series-heading">
    <h2 id="series-heading" class="display">최근 연재</h2>
    <h3><a href={seriesUrl}>{series.title}</a></h3>
    {series.summary && <p>{firstSentence(series.summary)}</p>}
  </section>}
</Shell>
<style>
  .hero { position: relative; height: clamp(400px, calc(100svh - 280px), 500px); overflow: hidden; }
  /* 그래프 상자는 뷰포트 안에 다 들어온다. 1600px 미만에서는 오른쪽 끝까지, 그 이상은 940px. 맞춤 배율이 상자에 맞춘다. */
  .hero-graph { position: absolute; top: 0; left: calc(50% - 160px); width: min(940px, 50% + 160px); height: 100%; }
  .hero-graph :global(svg), .hero-snapshot { display: block; width: 100%; height: 100%; }
  /* 오른쪽·위·아래 가장자리를 옅게. 색면과 간선이 헤더 선·대표 글 선에 닿거나 화면 끝에서 뚝 잘리지 않게 한다. 왼쪽은 종이색 그라데이션이 맡는다. */
  .hero-graph { -webkit-mask-image: linear-gradient(90deg, #000 0, #000 84%, transparent 100%), linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%); mask-image: linear-gradient(90deg, #000 0, #000 84%, transparent 100%), linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%); -webkit-mask-composite: source-in; mask-composite: intersect; }
  .hero-graph .graph { cursor: pointer; }
  .hero .graph .node.is-dim { opacity: 1; }
  /* 종이색은 소개 블록(오른쪽 끝 50% - 160px)보다 조금 더 가서 끝난다. 퍼센트로 두면 1280px에서 소개문 옆에 반투명 점이 걸친다. */
  .hero-fade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, var(--paper) 0, var(--paper) calc(50% - 140px), rgba(247,247,242,0) calc(50% + 140px)); }
  .hero-about { position: absolute; z-index: 1; left: calc(50% - 590px); top: 52px; width: 430px; }
  .featured { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: 28px 40px; padding: 44px 0 40px; border-top: 1px solid var(--ink); }
  .featured.has-thumbnail { grid-template-columns: minmax(0, 1fr) 280px; }
  .featured-image { display: block; width: 100%; }
  .featured-image :global(img) { display: block; width: 100%; height: auto; }
  @media (min-width: 721px) {
    /* 콜라주의 가장자리를 종이 배경으로 이어 주고, 그림은 열보다 조금 넓게 둔다. */
    .featured-image.is-soft :global(img) {
      width: calc(100% + 32px); max-width: none; margin: -12px -16px;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 90%, transparent), linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 18%, #000 90%, transparent), linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent);
      -webkit-mask-composite: source-in; mask-composite: intersect;
    }
  }
  .featured h2 { margin: 12px 0 10px; font-size: 34px; line-height: 1.3; letter-spacing: -.02em; max-width: 960px; }
  .featured h2 a { color: var(--ink); }
  .featured p { margin: 0; max-width: 34em; color: var(--muted); font-size: var(--t-body); line-height: 1.65; }
  .recent { padding: 48px 0 0; }
  /* 연재가 하나도 없으면 최근 기록이 마지막이라 아래 여백을 여기서 준다. */
  .recent:last-child { padding-bottom: 96px; }
  .latest-series { padding: 44px 0 96px; }
  .latest-series h2 { margin: 0 0 14px; font-size: var(--t-h2); }
  .latest-series h3 { margin: 0; padding-top: 19px; border-top: 1px solid var(--line); font-size: var(--t-list); font-weight: 550; line-height: 1.5; }
  .latest-series h3 a { color: var(--ink); }
  .latest-series p { margin: 10px 0 0; color: var(--muted); line-height: 1.7; }
  .recent h2 { margin: 0 0 14px; font-size: var(--t-h2); }
  .recent ol { list-style: none; margin: 0; padding: 0; }
  .recent li { display: grid; grid-template-columns: 110px minmax(0, 1fr) 64px; gap: 28px; align-items: baseline; padding: 19px 0; border-top: 1px solid var(--line); }
  .recent li:last-child { border-bottom: 1px solid var(--line); }
  .recent li a { color: var(--ink); font-size: var(--t-list); line-height: 1.5; }
  .recent li a.kind { font-size: var(--t-meta); color: var(--muted); text-align: right; }
  @media (max-width: 1240px) { .hero-graph { left: 460px; width: calc(100% - 460px); } .hero-about { left: 24px; } }
  /* 좁은 화면은 소개를 먼저 읽고 지도를 탐색한다. */
  @media (max-width: 1000px) {
    .hero { height: auto; overflow: visible; }
    .hero-graph { position: static; width: 100%; height: 280px; -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 8%, #000 92%, transparent 100%); mask-image: linear-gradient(180deg, transparent 0, #000 8%, #000 92%, transparent 100%); }
    .hero-fade { display: none; }
    .hero-about { position: relative; top: auto; left: auto; width: calc(100% - 48px); max-width: 640px; margin: 36px auto 12px; }
  }
  @media (max-width: 720px) {
    .hero-graph { height: clamp(220px, 55vw, 320px); margin: 4px 0 16px; }
    .hero-about { width: calc(100% - 40px); margin: 28px auto 8px; }
    .featured { padding: 32px 0 36px; }
    .featured.has-thumbnail { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .featured-image { max-width: 420px; }
    .featured h2 { font-size: 24px; }
    .featured p { font-size: 16px; }
    .recent li { grid-template-columns: 1fr; gap: 4px; padding: 16px 0; }
    .recent li a { font-size: 17px; }
    .recent li a.kind { text-align: left; }
  }
</style>
<script src="../scripts/hero.js"></script>
