---
import Shell from '../layouts/Shell.astro';
import { getGarden } from '../lib/get-garden.mjs';
const garden = await getGarden();
---
<Shell title="TaeZ" description={garden.home.about || 'TaeZ의 글, 개발 노트, 노트와 독서 기록.'} path="/">
  <section class="wrap" style="padding: 48px 0;">
    <h1 class="display" style="font-size: var(--t-h2);">소프트웨어 개발자 TaeZ</h1>
    <p style="color: var(--muted); max-width: 32em;">{garden.home.about}</p>
  </section>
</Shell>
