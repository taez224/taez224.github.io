---
import Shell from '../layouts/Shell.astro';
import '../styles/graph.css';
import About from '../components/About.astro';
import { getGarden } from '../lib/get-garden.ts';
import { withBase, inlineJson } from '../lib/format.ts';
import { inlineGraph } from '../lib/graph-data.ts';
import HomeList from '../components/HomeList.astro';
import HomeBooks from '../components/HomeBooks.astro';
import { recentActivity, homeBooks } from '../lib/home.ts';
import { layoutGraph, ATLAS_LAYOUT } from '../graph/layout.ts';
import { renderSnapshotSvg } from '../graph/snapshot.ts';
const garden = await getGarden();
const byPath = new Map(garden.notes.map((n) => [n.path, n]));
const featured = byPath.get(garden.home.featured[0]);
const thoughts = recentActivity(garden.notes, { kinds: ['slipbox'], limit: 4 });
const development = recentActivity(garden.notes, { kinds: ['development'], limit: 3 });
const articles = recentActivity(garden.notes, { kinds: ['blog'], series: garden.blog.series, exclude: [featured?.path], limit: 3 });
const books = homeBooks(garden.books, garden.home.featuredBook);
// 첫 화면과 터치 기기의 정적 지도. 인라인 SVG라 영역 이름에 페이지 서체가 적용된다. 720px보다 넓고 마우스를 쓰면 엔진이 이 그림을 대신한다.
const positions = layoutGraph(garden.nodes, garden.edges, { width: 1000, height: 640, ...ATLAS_LAYOUT });
// 노드의 연결과 좌우 순서는 유지하고, 넓은 무대에 맞춰 세로 간격만 줄인다. 엔진과 첫 그림에 같은 좌표를 넘긴다.
const widePositions = new Map([...positions].map(([id, p]) => [id, { x: p.x, y: 320 + (p.y - 320) * .7 }]));
const snapshotLabel = `생각 지도. 노드 ${garden.stats.nodes}개와 연결 ${garden.stats.edges}개.`;
// 데스크톱(1000px 초과)은 hero-graph.ts가 살아 있는 지도를 올리기 전까지 같은 모습의 정적 그림을 보여 교체가 눈에 띄지 않게 한다.
const snapshotDesktop = renderSnapshotSvg(garden.nodes, garden.edges, widePositions, { width: 1000, height: 640, preset: 'desktop', pixelHeight: 430, label: snapshotLabel });
// 중간 폭에서도 지도를 가로로 펼치되, 화면에 고정된 크기의 엔진 제목 대신 이 무대에 맞춘 정적 제목을 쓴다.
const tabletPositions = new Map([...widePositions].map(([id, p]) => [id, { x: p.x, y: p.y - 100 }]));
const snapshotTablet = renderSnapshotSvg(garden.nodes, garden.edges, tabletPositions, { width: 1000, height: 440, preset: 'tablet', font: 18, regionFont: 20, label: snapshotLabel });
const snapshot = renderSnapshotSvg(garden.nodes, garden.edges, positions, { width: 1000, height: 640, font: 26, regionFont: 30, compactRegionFont: 46, strokeWidth: 2, label: snapshotLabel });
---
<Shell title="TaeZ" description={garden.home.about} path="/">
  <section class="wrap hero" aria-label="소개와 생각 지도">
    <div class="hero-about"><About about={garden.home.about} contacts={garden.home.contacts} aboutUrl={withBase('/about/')} /></div>
    {/* 살아 있는 지도가 첫 화면 전에 올라오도록 데이터와 좌표를 페이지에 둔다. hero-graph.ts는 fetch 없이 이걸 읽는다. */}
    {/* 정적 그림은 전체를 눌러 지도를 연다. 살아 있는 지도에서는 노드가 노트로 이어지고 빈 곳은 이동하지 않는다. */}
    <div class="hero-map">
    <div class="hero-graph" data-graph>
      <script type="application/json" data-hero-data is:inline set:html={inlineJson(inlineGraph(garden.nodes, garden.edges, { positions: widePositions }))}></script>
      <a class="hero-snapshot" href={withBase('/map/')} aria-label="생각 지도 보기"><Fragment set:html={snapshotDesktop} /><Fragment set:html={snapshotTablet} /><Fragment set:html={snapshot} /></a>
    </div>
    <a class="hero-map-link" href={withBase('/map/')}>생각 지도 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <div class="wrap home-grid">
    <section class="home-articles" aria-labelledby="articles-heading">
      <header class="home-heading"><h2 id="articles-heading" class="display">글</h2><a href={withBase('/posts/')} aria-label="글 전체 보기">전체 보기</a></header>
      {featured && <article class="featured-copy">
        <span class="meta">대표 글</span>
        <h3 class="display"><a href={featured.url}>{featured.title}</a></h3>
        {featured.summaryIsExplicit && <p>{featured.summary}</p>}
      </article>}
      <HomeList rows={articles} />
    </section>
    <section class="home-thoughts" aria-labelledby="thoughts-heading">
      <header class="home-heading"><h2 id="thoughts-heading" class="display">생각 노트</h2><a href={withBase('/map/')} aria-label="생각 지도에서 보기">지도에서 보기</a></header>
      <HomeList rows={thoughts} />
    </section>
    <section class="home-development" aria-labelledby="development-heading">
      <header class="home-heading"><h2 id="development-heading" class="display">개발 노트</h2><a href={withBase('/dev/')} aria-label="개발 노트 전체 보기">전체 보기</a></header>
      <HomeList rows={development} />
    </section>
    {books.length > 0 && <section class="home-books" aria-labelledby="books-heading">
      <header class="home-heading"><h2 id="books-heading" class="display">책장</h2><a href={withBase('/books/')} aria-label="책장 전체 보기">전체 보기</a></header>
      <HomeBooks books={books} />
    </section>}
  </div>
</Shell>
<style>
  /* 두 칸 모두 문서 흐름에 둔다. 소개가 길어지거나 글자를 키워도 지도와 겹치지 않고 첫 화면 높이가 늘어난다. */
  .hero { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 36px; align-items: center; padding: 24px 0 0; }
  .hero-map { min-width: 0; }
  .hero-map-link { display: none; }
  @media (min-width: 721px) and (hover: hover) and (pointer: fine) {
    .hero-map-link { display: block; width: fit-content; margin-left: auto; padding-block: 4px; font-size: var(--t-meta); color: var(--muted); line-height: 1.6; }
  }
  .hero-about { min-width: 0; padding: 24px 0; }
  .hero-graph { position: relative; min-width: 0; width: 100%; height: 430px; }
  .hero-graph :global(svg), .hero-snapshot { display: block; width: 100%; height: 100%; }
  .hero-graph .hero-snapshot :global(.is-mobile) { display: none; }
  .hero-graph .hero-snapshot :global(.is-tablet) { display: none; }
  .hero-snapshot :global(.snap-regions-compact) { display: none; }
  /* 터치 스크롤과 휴대폰의 제목 간격을 지킨다. 중간 폭에서도 마우스를 쓰면 호버와 노트 이동을 제공한다.
     경계는 hero-graph.ts의 LIVE_HERO_QUERY와 같다. 정적 그림은 창을 줄일 때 다시 보인다. */
  .hero-graph > :global(.graph) { display: none; }
  @media (min-width: 721px) and (hover: hover) and (pointer: fine) {
    .hero-graph > :global(.graph) { display: block; }
    .hero-graph.is-live .hero-snapshot { display: none; }
  }
  /* 스냅샷의 색면 불투명도는 SVG 속성이라 어두운 화면에서는 CSS로 엔진과 같은 값까지 올린다. */
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme])) .hero-snapshot :global([data-regions]) { opacity: .11; } }
  :global(:root[data-theme="dark"]) .hero-snapshot :global([data-regions]) { opacity: .11; }
  /* 넓은 화면의 네 가장자리 흐림은 두 SVG가 안에서 도형 층에만 씌운다(src/graph/hero-fade.ts). 상자에 CSS 마스크를 걸면 가장자리 가까이 놓인 영역 이름까지 흐려진다. */
  .hero-graph > :global(.graph) { cursor: default; }
  .home-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); grid-template-areas: 'thoughts articles' 'development books'; gap: 56px 64px; padding-block: 8px 64px; align-items: start; }
  .home-grid > section { min-width: 0; }
  .home-articles { grid-area: articles; }
  .home-thoughts { grid-area: thoughts; }
  .home-development { grid-area: development; }
  .home-books { grid-area: books; }
  .home-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--ink); }
  .home-heading h2 { margin: 0; font-size: var(--t-section); }
  .home-heading > a { flex-shrink: 0; color: var(--muted); font-size: var(--t-side); padding-block: 8px; }
  .home-heading > a:focus-visible { text-decoration: underline; text-underline-offset: .25em; }
  @media (hover: hover) { .home-heading > a:hover { text-decoration: underline; text-underline-offset: .25em; } }
  .featured-copy { padding-block: 22px 26px; border-bottom: 1px solid var(--line); }
  .featured-copy h3 { margin: 8px 0 16px; font-size: var(--t-featured); line-height: 1.45; text-wrap: balance; word-break: keep-all; overflow-wrap: anywhere; }
  .featured-copy p { margin: 0; color: var(--muted); font-size: var(--t-body); line-height: 1.75; }
  @media (max-width: 720px) {
    .home-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'articles' 'thoughts' 'development' 'books'; gap: 40px; padding-block: 4px 40px; }
    .home-heading { padding-bottom: 8px; }
    .featured-copy { padding-top: 14px; }
  }
  @media (max-width: 1120px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0; }
    .hero-about { max-width: 640px; padding: 36px 0 16px; }
  }
  /* 좁은 화면에서는 기존 정적 배치를 쓰고, 링크와 영역 이름을 그대로 남긴다. */
  @media (max-width: 1000px) {
    .hero-graph { height: 375px; }
    .hero-graph .hero-snapshot :global(.is-desktop) { display: none; }
    .hero-graph .hero-snapshot :global(.is-tablet) { display: block; }
  }
  @media (max-width: 720px) {
    .hero-graph .hero-snapshot :global(.is-tablet) { display: none; }
    .hero-graph .hero-snapshot :global(.is-mobile) { display: block; }
    /* 휴대폰 폭에서는 허브 제목이 읽을 수 없을 만큼 작아서 제목 층을 숨기고 영역 이름만 크게 놓은 층으로 바꾼다. */
    .hero-snapshot :global(.snap-regions), .hero-snapshot :global(.snap-titles) { display: none; }
    .hero-snapshot :global(.snap-regions-compact) { display: inline; }
    /* 홈에서 한 편을 읽기 시작할 수 있도록 대표 글 첫 줄의 공간을 남긴다. 화면 높이에 따라 연속해서 줄이되
       지도는 150px보다 작게 만들지 않는다. 소개문 길이가 바뀌면 높이에서 빼는 530px을 실제 콘텐츠로 다시 잰다. */
    .hero { padding-bottom: 0; }
    .hero-graph { height: clamp(230px, 78vw, 350px); height: clamp(150px, calc(100svh - 530px), clamp(230px, 78vw, 350px)); margin-bottom: 8px; }
    .hero-about { padding: 20px 0 0; }
  }
</style>
<script src="../scripts/hero.ts"></script>
