---
import Shell from '../layouts/Shell.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import '../styles/graph.css';
import About from '../components/About.astro';
import { getGarden } from '../lib/get-garden.ts';
import { formatDate, withBase, firstSentence, inlineJson, topicColor } from '../lib/format.ts';
import { inlineGraph } from '../lib/graph-data.ts';
import { parentLink } from '../lib/note-nav.ts';
import { latestSeries } from '../lib/blog.ts';
import { recentByKind } from '../lib/home.ts';
import { KINDS } from '../lib/kinds.ts';
import { kindPrefix } from '../lib/slug.ts';
import { layoutGraph, ATLAS_LAYOUT } from '../graph/layout.ts';
import { renderSnapshotSvg } from '../graph/snapshot.ts';
const garden = await getGarden();
const byPath = new Map(garden.notes.map((n) => [n.path, n]));
const entry = byPath.get(garden.config.entry ?? '');
const featured = byPath.get(garden.home.featured[0]);
const featuredEntry = featured ? await getEntry('notes', `${kindPrefix(featured.kind)}/${featured.slug}`) : null;
const thumbnail = featuredEntry?.data.thumbnail;
const softThumbnail = featured?.thumbnailStyle === 'soft';
// 최근 기록은 종류마다 최신 한 편이다. 고르는 규칙은 recentByKind에 있고, 대표 글은 위에 따로 보이므로 뺀다.
const recent = recentByKind(garden.notes, { kinds: ['slipbox', 'development', 'blog'], series: garden.blog.series, exclude: [featured?.path] })
  .map((note) => ({ note, label: KINDS[note.kind].label, listUrl: withBase(parentLink(note).path) }));
// 공개된 마지막 편이 가장 최근인 연재 하나. 없으면 이 영역을 그리지 않는다.
const series = latestSeries(garden.blog.series);
const seriesUrl = series && (series.noteUrl || series.posts[0]?.url);
// 연재 전체를 대표하는 이미지는 허브가 정한다. 각 편의 이미지를 대신 가져오지 않는다.
const seriesNote = series?.noteUrl ? garden.notes.find((note) => note.url === series.noteUrl) : null;
const seriesEntry = seriesNote?.thumbnail ? await getEntry('notes', `${kindPrefix(seriesNote.kind)}/${seriesNote.slug}`) : null;
const seriesThumbnail = seriesEntry?.data.thumbnail;
const softSeriesThumbnail = seriesNote?.thumbnailStyle === 'soft';
// 모바일 홈의 정적 지도. <img>가 아니라 인라인이라 영역 이름에 페이지 서체가 적용된다. 데스크톱은 hero.js가 살아 있는 지도로 바꾼다.
const positions = layoutGraph(garden.nodes, garden.edges, { width: 1000, height: 640, ...ATLAS_LAYOUT });
const snapshotLabel = `생각 지도. 노드 ${garden.stats.nodes}개와 연결 ${garden.stats.edges}개.`;
// 데스크톱(1000px 초과)은 hero.js가 살아 있는 지도로 바꾸기 전까지 같은 모습의 정적 그림을 보여 교체가 눈에 띄지 않게 한다.
const snapshotDesktop = renderSnapshotSvg(garden.nodes, garden.edges, positions, { width: 1000, height: 640, preset: 'desktop', pixelHeight: 500, label: snapshotLabel });
const snapshot = renderSnapshotSvg(garden.nodes, garden.edges, positions, { width: 1000, height: 640, font: 26, regionFont: 30, strokeWidth: 2, label: snapshotLabel });
---
<Shell title="TaeZ" description={garden.home.about} path="/">
  <section class="hero" aria-label="소개와 생각 지도">
    <div class="hero-about"><About about={garden.home.about} contacts={garden.home.contacts} entryUrl={entry?.url ?? withBase('/map/')} aboutUrl={withBase('/about/')} /></div>
    {/* 살아 있는 지도가 첫 화면 전에 올라오도록 데이터와 좌표를 페이지에 둔다. hero.js는 fetch 없이 이걸 읽는다. */}
    <div class="hero-graph" data-graph><script type="application/json" data-hero-data is:inline set:html={inlineJson(inlineGraph(garden.nodes, garden.edges, { positions }))}></script><a class="hero-snapshot" href={withBase('/map/')} aria-label="생각 지도 보기"><Fragment set:html={snapshotDesktop} /><Fragment set:html={snapshot} /></a></div>
    <div class="hero-fade" aria-hidden="true"></div>
    <a class="hero-map-link" href={withBase('/map/')}>생각 지도 보기 <span aria-hidden="true">→</span></a>
  </section>
  {/* 대표 글 썸네일은 데스크톱 첫 화면 안에 있다. lazy로 두면 LCP 후보가 늦게 시작한다. */}
  {featured && <section class="wrap home-section featured" aria-labelledby="featured-heading">
    <div class="section-info">
      <h2 id="featured-heading" class="display section-title">대표 글</h2>
      <div class="meta featured-meta"><time datetime={featured.date}>{formatDate(featured.date)}</time>{featured.publication && <span>{featured.publication}</span>}</div>
    </div>
    <div class:list={['featured-content', { 'has-thumbnail': thumbnail }]}>
      <div class="featured-copy">
        <h3 class="display"><a href={featured.url}>{featured.title}</a></h3>
        {featured.summaryIsExplicit && <p>{featured.summary}</p>}
      </div>
      {thumbnail && <a class:list={['featured-image', { 'is-soft': softThumbnail }]} href={featured.url} aria-label={featured.title}>
        <Image src={thumbnail} alt="" width={560} widths={[280, 560, 840]} sizes="(max-width: 460px) calc(100vw - 40px), (max-width: 720px) 420px, (max-width: 1000px) 200px, 280px" format="webp" loading="eager" fetchpriority="high" decoding="sync" />
      </a>}
    </div>
  </section>}
  <section class="wrap home-section recent" aria-labelledby="recent-heading">
    <h2 id="recent-heading" class="display section-title">최근 기록</h2>
    <ol>{recent.map(({ note, label, listUrl }) => <li>
      <time class="meta recent-date" datetime={note.date}>{formatDate(note.date)}</time>
      <a class="meta recent-kind" href={listUrl}>{label}</a>
      <a class="recent-title" href={note.url}>{note.title}</a>
      <span class="meta recent-topic"><i style={`background:${topicColor(note.topic)}`} aria-hidden="true"></i>{note.topicTag || note.topic}</span>
    </li>)}</ol>
  </section>
  {series && seriesUrl && <section class="wrap home-section latest-series" aria-labelledby="series-heading">
    <div class="section-info">
      <h2 id="series-heading" class="display section-title">최근 연재</h2>
      <p class="meta series-meta">{series.posts.length}편 · {series.ended ? '완결' : '진행 중'}</p>
    </div>
    <div class:list={['featured-content', { 'has-thumbnail': seriesThumbnail }]}>
      <div class="series-copy"><h3><a href={seriesUrl}>{series.title}</a></h3>
        {series.summary && <p>{firstSentence(series.summary)}</p>}
      </div>
      {seriesThumbnail && <a class:list={['featured-image', { 'is-soft': softSeriesThumbnail }]} href={seriesUrl} aria-label={series.title}>
        <Image src={seriesThumbnail} alt="" width={560} widths={[280, 560, 840]} sizes="(max-width: 460px) calc(100vw - 40px), (max-width: 720px) 420px, (max-width: 1000px) 200px, 280px" format="webp" loading="lazy" decoding="async" />
      </a>}
    </div>
  </section>}

</Shell>
<style>
  .hero { position: relative; height: clamp(400px, calc(100svh - 280px), 500px); overflow: hidden; }
  .hero-map-link { position: absolute; z-index: 1; right: max(24px, calc(50% - 590px)); bottom: 16px; padding: 10px 0; font-size: var(--t-side); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
  /* 그래프 상자는 뷰포트 안에 다 들어온다. 1600px 미만에서는 오른쪽 끝까지, 그 이상은 940px. 맞춤 배율이 상자에 맞춘다. */
  .hero-graph { position: absolute; top: 0; left: calc(50% - 160px); width: min(940px, 50% + 160px); height: 100%; }
  .hero-graph :global(svg), .hero-snapshot { display: block; width: 100%; height: 100%; }
  .hero-graph .hero-snapshot :global(.is-mobile) { display: none; }
  /* 오른쪽·위·아래 가장자리를 옅게. 색면과 간선이 헤더 선·대표 글 선에 닿거나 화면 끝에서 뚝 잘리지 않게 한다. 왼쪽은 종이색 그라데이션이 맡는다. */
  .hero-graph { -webkit-mask-image: linear-gradient(90deg, #000 0, #000 84%, transparent 100%), linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%); mask-image: linear-gradient(90deg, #000 0, #000 84%, transparent 100%), linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%); -webkit-mask-composite: source-in; mask-composite: intersect; }
  .hero-graph .graph { cursor: pointer; }
  /* 종이색은 소개 블록(오른쪽 끝 50% - 160px)보다 조금 더 가서 끝난다. 퍼센트로 두면 1280px에서 소개문 옆에 반투명 점이 걸친다. */
  .hero-fade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, var(--paper) 0, var(--paper) calc(50% - 140px), rgba(247,247,242,0) calc(50% + 140px)); }
  .hero-about { position: absolute; z-index: 1; left: calc(50% - 590px); top: 52px; width: 430px; }
  .home-section { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 40px; padding: 36px 0; border-top: 1px solid var(--line); }
  .section-title { margin: 0; font-size: var(--t-h2); line-height: 1.4; letter-spacing: -.02em; }
  .featured { padding-top: 44px; padding-bottom: 40px; border-top-color: var(--ink); }
  .featured-meta { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }
  .latest-series .series-meta { margin: 12px 0 0; font-size: var(--t-meta); line-height: 1.6; }
  .featured-content { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; gap: 28px 40px; }
  .featured-content.has-thumbnail { grid-template-columns: minmax(0, 1fr) 280px; }
  .featured-copy h3 { margin: 0 0 14px; font-size: 34px; line-height: 1.3; letter-spacing: -.02em; }
  .featured-copy h3 a { color: var(--ink); }
  .featured-copy p { margin: 0; color: var(--muted); font-size: var(--t-body); line-height: 1.7; }
  .featured-image { display: block; width: 100%; }
  .featured-image :global(img) { display: block; width: 100%; height: auto; }
  @media (min-width: 721px) {
    .featured-image.is-soft :global(img) {
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 90%, transparent), linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 18%, #000 90%, transparent), linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent);
      -webkit-mask-composite: source-in; mask-composite: intersect;
    }
  }
  .recent ol { list-style: none; margin: 0; padding: 0; }
  .recent li { display: grid; grid-template-columns: 100px 80px minmax(0, 1fr) 90px; gap: 20px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .recent li:first-child { padding-top: 0; }
  .recent li:last-child { border-bottom: 0; padding-bottom: 0; }
  .recent-title { color: var(--ink); font-size: var(--t-list); font-weight: 550; line-height: 1.5; }
  .recent-kind { color: var(--muted); }
  .recent-topic { display: inline-flex; align-items: center; gap: 6px; }
  .recent-topic i { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; }
  .latest-series h3 { margin: 0; font-size: var(--t-list); font-weight: 550; line-height: 1.5; }
  .latest-series p { margin: 10px 0 0; color: var(--muted); line-height: 1.7; }
  .home-section:last-child { padding-bottom: 96px; }
  @media (min-width: 721px) and (max-width: 1000px) {
    .home-section { grid-template-columns: 100px minmax(0, 1fr); gap: 28px; }
    .featured-content.has-thumbnail { grid-template-columns: minmax(0, 1fr) 200px; gap: 24px; }
    .featured-copy h3 { font-size: 28px; }
    .recent li { grid-template-columns: 90px 70px minmax(0, 1fr); gap: 12px; }
    .recent-topic { grid-column: 3; }
  }
  @media (max-width: 1240px) { .hero-graph { left: 460px; width: calc(100% - 460px); } .hero-about { left: 24px; } }
  /* 좁은 화면은 소개를 먼저 읽고 지도를 탐색한다. */
  @media (max-width: 1000px) {
    .hero { height: auto; overflow: visible; }
    .hero-graph { position: static; width: 100%; height: 280px; -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 8%, #000 92%, transparent 100%); mask-image: linear-gradient(180deg, transparent 0, #000 8%, #000 92%, transparent 100%); }
    .hero-fade { display: none; }
    .hero-graph .hero-snapshot :global(.is-desktop) { display: none; }
    .hero-graph .hero-snapshot :global(.is-mobile) { display: block; }
    .hero-about { position: relative; top: auto; left: auto; width: calc(100% - 48px); max-width: 640px; margin: 36px auto 12px; }
  }
  @media (max-width: 720px) {
    .hero-map-link { position: static; display: block; width: fit-content; margin: -12px 20px 16px auto; }
    .hero-graph { height: clamp(220px, 55vw, 320px); margin: 4px 0 16px; }
    .hero-about { width: calc(100% - 40px); margin: 28px auto 8px; }
    .home-section { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 28px 0; }
    .featured-meta { flex-direction: row; flex-wrap: wrap; gap: 4px 12px; margin-top: 8px; }
    .latest-series .series-meta { margin-top: 8px; }
    .featured-content.has-thumbnail { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .featured-image { max-width: 420px; }
    .featured-copy h3 { font-size: 24px; }
    .recent li { grid-template-columns: auto minmax(0, 1fr) auto; gap: 6px 12px; padding: 16px 0; }
    .recent-title { grid-column: 1 / -1; grid-row: 1; font-size: 18px; }
    .recent-date { grid-column: 1; grid-row: 2; }
    .recent-kind { grid-column: 2; grid-row: 2; }
    .recent-topic { grid-column: 3; grid-row: 2; }
    .home-section:last-child { padding-bottom: 64px; }

  }
</style>
<script src="../scripts/hero.ts"></script>
