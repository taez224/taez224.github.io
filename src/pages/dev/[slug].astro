---
import { getCollection } from 'astro:content';
import NotePage from '../../components/NotePage.astro';
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.kind === 'development');
  return notes.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<NotePage entry={entry} />
