---
import Shell from '../../layouts/Shell.astro';
import { getGarden } from '../../lib/get-garden.mjs';
import { technologyTags, selectDevelopmentRecords } from '../../lib/development.mjs';
import { developmentCategoryLabel, formatDate } from '../../lib/format.mjs';
const { development } = await getGarden();
const records = selectDevelopmentRecords([...development.concepts, ...development.troubleshooting, ...development.tools]);
// 분류가 여백 라벨이 된다. 탭과 기술 칩으로 거르던 것은 메타 줄의 기술명과 검색으로 대신한다.
const groups = ['Concepts', 'Troubleshooting', 'Tools'].map((id) => ({ id, label: developmentCategoryLabel(id), records: records.filter((r) => r.category === id) })).filter((g) => g.records.length);
---
<Shell title="개발 노트" description="개발하며 배운 개념과 해결한 문제, 도구 기록." path="/dev/" active="dev">
  <div class="wrap dev-page">
    <div class="page-head"><h1 class="display">개발 노트</h1><span class="meta">{records.length}개</span></div>
    {groups.map((g) => <section class="ledger-group is-word" aria-label={g.label}>
      <div class="ledger-head"><h2 class="display">{g.label}</h2><span class="meta">{g.records.length}개</span></div>
      <div class="ledger-rows">{g.records.map((r) => <article class="ledger-row">
        <div>
          <h3><a href={r.url}>{r.title}</a></h3>
          <div class="meta">{technologyTags(r.tags).length > 0 && <span>{technologyTags(r.tags).join(' · ')}</span>}{r.date && <time datetime={r.date}>{formatDate(r.date)}</time>}</div>
        </div>
        {r.summary ? <p class="summary">{r.summary}</p> : <div></div>}
      </article>)}</div>
    </section>)}
  </div>
</Shell>
<style>
  .dev-page { padding: 36px 0 96px; }
  .page-head { display: flex; align-items: baseline; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .page-head h1 { margin: 0; font-size: 28px; line-height: 1.4; }
</style>
