---
import Shell from '../../layouts/Shell.astro';
import MapPanel from '../../components/MapPanel.astro';
import { getGarden } from '../../lib/get-garden.mjs';
import { withBase, GRAPH_COLORS } from '../../lib/format.mjs';
import '../../styles/graph.css';
const { nodes, stats, topicFold } = await getGarden();
const startpoints = nodes.filter((n) => n.isEntry);
const hubs = nodes.filter((n) => n.type === 'hub' && !n.isEntry).sort((a, b) => (b.degree ?? 0) - (a.degree ?? 0));
// 범례는 지도에 실제 있는 주제만, 노드 많은 순. 기타는 맨 끝에 두고 접힌 주제 이름을 옆에 옅게 적는다(색은 같지만 태그는 남는다).
const topicCounts = new Map();
for (const n of nodes) topicCounts.set(n.topic, (topicCounts.get(n.topic) ?? 0) + 1);
const folded = Object.keys(topicFold);
const topics = [...topicCounts].map(([name, count]) => ({ name, color: GRAPH_COLORS[name] ?? GRAPH_COLORS.기타, count })).sort((a, b) => Number(a.name === '기타') - Number(b.name === '기타') || b.count - a.count);
---
<Shell title="생각 지도" description="노트를 고르고 연결된 생각을 따라가는 지도." path="/map/" active="map">
  <div class="wrap map-page" data-site={withBase('/data/site.json')}>
    <div class="page-head"><h1 class="display">생각 지도</h1><span class="meta" data-map-count>노트 {stats.nodes} · 연결 {stats.edges}</span></div>
    <div class="map-layout">
      <div class="map-stage">
        <div class="map-toolbar">
          <div class="legend">
            <span class="legend-item"><svg width="24" height="8" viewBox="0 0 24 8" aria-hidden="true"><line x1="1" y1="4" x2="23" y2="4" style="stroke:var(--accent)" stroke-width="2"></line></svg>참조</span>
            <span class="legend-item"><svg width="24" height="8" viewBox="0 0 24 8" aria-hidden="true"><line x1="1" y1="4" x2="23" y2="4" style="stroke:var(--accent)" stroke-width="1.7" stroke-dasharray="5 4"></line></svg>역참조</span>
            <span class="legend-sep"></span>
            {topics.map((t) => <button type="button" class="legend-item" data-topic={t.name} aria-pressed="false"><i style={`width:10px;height:10px;border-radius:50%;background:${t.color}`}></i>{t.name}{t.name === '기타' && folded.length > 0 && <span class="legend-fold">· {folded.join(', ')}</span>}</button>)}
            <button type="button" class="legend-item" data-hub-filter aria-pressed="false"><i style="width:10px;height:10px;border-radius:50%;border:1.2px solid var(--accent)"></i>허브</button>
          </div>
        </div>
        <div class="graph-box">
          <svg data-map role="group" aria-label="생각 지도. 노드를 고르면 오른쪽에 정보가 나타납니다."></svg>
          <div class="graph-controls" aria-label="확대·축소">
            <button type="button" data-graph-zoom="out" aria-label="축소">−</button>
            <button type="button" data-graph-zoom="fit">맞춤</button>
            <button type="button" data-graph-zoom="in" aria-label="확대">+</button>
          </div>
        </div>
      </div>
      <MapPanel startpoints={startpoints} hubs={hubs} />
    </div>
  </div>
</Shell>
<style is:global>
  .map-page { padding: 24px 0 48px; }
  .page-head { display: flex; align-items: baseline; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .page-head h1 { margin: 0; font-size: 28px; }
  .map-layout { display: grid; grid-template-columns: minmax(0, 1fr) 310px; gap: 40px; margin-top: 16px; align-items: stretch; }
  .graph-box { height: calc(100dvh - 270px); min-height: 420px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .map-panel { max-height: calc(100dvh - 270px + 88px); }
  /* 범례는 위 한 줄, 확대 컨트롤은 지도 앱처럼 무대 오른쪽 아래에 띄운다. */
  .map-toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .map-toolbar .legend { flex: 1 1 auto; gap: 4px 12px; margin-top: 0; min-width: 0; }
  .map-toolbar .legend-item { gap: 5px; padding: 4px 4px; white-space: nowrap; }
  .legend-fold { margin-left: 2px; color: var(--faint); font-weight: 400; }
  .graph-box { position: relative; }
  .map-stage { min-width: 0; } /* 그리드 아이템이 범례의 min-content 폭으로 늘어나 페이지가 넘치지 않게 */
  .graph-controls { position: absolute; right: 12px; bottom: 12px; display: flex; gap: 4px; padding: 3px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper-strong); }
  .graph-controls button { border: 0; }
  @media (max-width: 999.98px) {
    .map-layout { grid-template-columns: 1fr; gap: 24px; }
    .graph-box { height: 60vh; min-height: 360px; }
    .map-panel .scroll-list.is-long .side-list { max-height: none; }
    .map-panel .scroll-list.is-long::after { display: none; }
  }
  @media (min-width: 720.02px) and (max-width: 999.98px) { .map-panel { max-height: none; } }
  @media (max-width: 720px) {
    .map-page { padding-top: 16px; }
    .graph-box { width: 100vw; margin-left: calc(50% - 50vw); height: 60vh; }
    .graph-controls button { min-width: 40px; min-height: 40px; }
    /* 범례는 한 줄 가로 스크롤. 참조·역참조 선 범례는 빼고 오른쪽 끝을 옅게 해 더 있음을 알린다. */
    .map-toolbar { align-items: center; gap: 8px; }
    .map-toolbar .legend { flex-wrap: nowrap; gap: 4px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); }
    .map-toolbar .legend::-webkit-scrollbar { display: none; }
    .map-toolbar .legend::after { flex: 0 0 24px; content: ""; }
    .map-toolbar span.legend-item, .map-toolbar .legend-sep { display: none; }
    .map-toolbar .legend-item { flex: 0 0 auto; min-height: 36px; }
  }
</style>
<script src="../../scripts/map.js"></script>
