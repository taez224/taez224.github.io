---
import Shell from '../../layouts/Shell.astro';
import MapPanel from '../../components/MapPanel.astro';
import { getGarden } from '../../lib/get-garden.ts';
import { topicColor, inlineJson } from '../../lib/format.ts';
import { inlineGraph, inlinePanelNotes } from '../../lib/graph-data.ts';
import '../../styles/graph.css';
const { nodes, edges, notes, noteEdges, stats, topicFold } = await getGarden();
const startpoints = nodes.filter((n) => n.isEntry);
const hubs = nodes.filter((n) => n.type === 'hub' && !n.isEntry).sort((a, b) => (b.degree ?? 0) - (a.degree ?? 0));
// 범례는 지도에 실제 있는 주제만, 노드 많은 순. 기타는 맨 끝에 두고 접힌 주제 이름을 옆에 옅게 적는다(색은 같지만 태그는 남는다).
const topicCounts = new Map<string, number>();
for (const n of nodes) topicCounts.set(n.topic, (topicCounts.get(n.topic) ?? 0) + 1);
const folded = Object.keys(topicFold);
// 접힌 주제가 늘어도 범례가 길어지지 않게 둘까지만 적고 나머지는 수로. 전체 목록은 툴팁.
const foldedLabel = folded.length > 2 ? `${folded.slice(0, 2).join(', ')} 외 ${folded.length - 2}` : folded.join(', ');
const topics = [...topicCounts].map(([name, count]) => ({ name, color: topicColor(name), count })).sort((a, b) => Number(a.name === '기타') - Number(b.name === '기타') || b.count - a.count);
---
<Shell title="생각 지도" description="노트를 고르고 연결된 생각을 따라가는 지도." path="/map/" active="map" footer={false}>
  {/* 그래프와 패널이 쓰는 데이터를 전부 페이지에 인라인한다. 스크립트가 실행되는 즉시(첫 화면 전에) 그래프와 선택된 노트 패널까지 한 번에 그린다. */}
  <div class="wrap map-page">
    <script type="application/json" data-map-data is:inline set:html={inlineJson({ ...inlineGraph(nodes, edges, { extra: ['path', 'mapKey'] }), ...inlinePanelNotes(notes, noteEdges, topicFold) })}></script>
    <div class="page-head"><h1 class="display">생각 지도</h1><span class="meta" role="status" data-map-count>노트 {stats.nodes} · 연결 {stats.edges}</span></div>
    <div class="map-layout">
      <div class="map-stage">
        <div class="map-toolbar">
          {/* 범례 줄에는 누르면 거르는 필터만 둔다. 실선·점선은 노드를 골랐을 때만 나오고, 그때 뜨는 패널 목록의 아이콘(ref-icons.ts)이 선 범례를 맡는다. */}
          <div class="legend">
            {topics.map((t) => <button type="button" class="legend-item" data-topic={t.name} aria-pressed="false" title={t.name === '기타' && folded.length > 0 ? `기타로 접힌 주제: ${folded.join(', ')}` : undefined}><i style={`width:10px;height:10px;border-radius:50%;background:${t.color}`}></i>{t.name}{t.name === '기타' && folded.length > 0 && <span class="legend-fold">· {foldedLabel}</span>}</button>)}
            <button type="button" class="legend-item" data-hub-filter aria-pressed="false"><i style="width:10px;height:10px;border-radius:50%;border:1.2px solid var(--accent)"></i>허브</button>
          </div>
        </div>
        <div class="graph-box">
          {/* 노드는 버튼으로 읽히는데 Space와 Enter가 다른 일을 한다. 버튼의 약속과 다르므로 설명을 붙인다. */}
          <p id="map-keys" class="visually-hidden">노드에서 Enter를 누르면 그 노트를 열고, Space를 누르면 지도에 머문 채 노트 정보를 봅니다.</p>
          <svg data-map role="group" aria-describedby="map-keys" aria-label="생각 지도. 노드를 고르면 선택한 노트의 정보가 나타납니다."></svg>
          <div class="graph-controls" aria-label="확대·축소">
            <button type="button" data-graph-zoom="out" aria-label="축소">−</button>
            <button type="button" data-graph-zoom="fit">맞춤</button>
            <button type="button" data-graph-zoom="in" aria-label="확대">+</button>
          </div>
        </div>
        {/* 휴대폰 폭에서는 패널이 노드를 고른 뒤에 열리는 시트라 처음 화면에 들어갈 곳이 없다. 데스크톱 패널의 처음 내용과 같은 목록을 그래프 아래에 둔다. */}
        <div class="map-start" data-map-start>
          <p class="meta map-start-hint">노드를 누르면 노트 정보가 아래에서 열립니다.</p>
          <section class="list-block"><div class="meta">시작점</div><ul class="side-list">{startpoints.map((h) => <li><a href={h.url} data-node={h.id}><i class="hub-mark" aria-hidden="true"></i>{h.displayTitle}</a></li>)}</ul></section>
          {hubs.length > 0 && <section class="list-block"><div class="meta">허브</div><ul class="side-list">{hubs.map((h) => <li><a href={h.url} data-node={h.id}><i class="hub-mark" aria-hidden="true"></i>{h.displayTitle}</a></li>)}</ul></section>}
        </div>
      </div>
      <MapPanel startpoints={startpoints} hubs={hubs} />
    </div>
  </div>
</Shell>
<style is:global>
  .map-page { padding: var(--s-page-top-index) 0 48px; }
  .map-layout { display: grid; grid-template-columns: minmax(0, 1fr) var(--s-sidebar); gap: var(--s-column-gap); margin-top: 16px; align-items: stretch; }
  /* 무대는 화면 높이에서 헤더·제목·범례·아래 여백(246px)과 페이지 위쪽 여백을 뺀 만큼이다. 패널은 여기에 범례 줄(88px)만큼 더 길다. */
  .graph-box { height: calc(100dvh - 246px - var(--s-page-top-index)); min-height: 420px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .map-panel { max-height: calc(100dvh - 158px - var(--s-page-top-index)); }
  /* 범례는 위 한 줄, 확대 컨트롤은 지도 앱처럼 무대 오른쪽 아래에 띄운다. */
  .map-toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .legend { display: flex; flex: 1 1 auto; flex-wrap: wrap; align-items: center; gap: 4px 12px; min-width: 0; }
  .legend-item { display: inline-flex; align-items: center; gap: 5px; padding: 4px; border: 0; border-radius: 4px; background: transparent; color: var(--muted); font-size: var(--t-meta); white-space: nowrap; transition: background-color .15s ease, color .15s ease; }
  /* 선택은 책장 거르개와 같이 글자 폭만큼 얹은 2px 먹색 막대다. 글자도 먹색으로 올려 접힌 주제 이름까지 함께 따라온다. */
  .legend button.legend-item[aria-pressed="true"] { position: relative; color: var(--accent); }
  .legend button.legend-item[aria-pressed="true"]::after { position: absolute; right: 4px; bottom: 0; left: 4px; height: 2px; background: var(--accent); content: ""; }
  .legend button.legend-item[aria-pressed="true"] .legend-fold { color: inherit; }
  @media (hover: hover) { .legend button.legend-item:hover { background: var(--accent-soft); color: var(--accent); } }
  .legend-fold { margin-left: 2px; color: var(--muted); font-weight: 400; }
  .graph-box { position: relative; }
  .map-stage { min-width: 0; }
  .map-start { display: none; } /* 그리드 아이템이 범례의 min-content 폭으로 늘어나 페이지가 넘치지 않게 */
  .graph-controls { position: absolute; right: 12px; bottom: 12px; display: flex; gap: 4px; padding: 3px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper-strong); }
  .graph-controls button { min-width: 36px; min-height: 36px; padding: 3px 9px; border: 0; border-radius: 4px; background: transparent; color: var(--muted); font-size: var(--t-meta); transition: background-color .15s ease, color .15s ease, transform .15s cubic-bezier(.23, 1, .32, 1); }
  .graph-controls button:active { transform: scale(.97); }
  /* 확대 버튼도 범례·필터와 같은 투명 버튼이라 호버 때 같은 옅은 판을 깐다. */
  @media (hover: hover) { .graph-controls button:hover { background: var(--accent-soft); color: var(--accent); } }
  @media (max-width: 1000px) {
    .map-layout { grid-template-columns: 1fr; gap: 24px; }
    .graph-box { height: 60vh; min-height: 360px; }
    .map-panel .scroll-list.is-long .side-list { max-height: none; }
    .map-panel .scroll-list.is-long::after { display: none; }
  }
  /* 한 열로 바뀌면 패널이 무대 아래로 내려가 노드를 골라도 화면 밖에서 바뀐다. 어디서 열리는지 한 줄로 알린다.
     시작점·허브 목록은 그 패널이 이미 보여 주므로 여기서는 감춘다. */
  @media (min-width: 721px) and (max-width: 1000px) {
    .map-panel { max-height: none; }
    .map-start { display: block; padding-top: 14px; }
    .map-start .list-block { display: none; }
    .map-start-hint { margin: 0; }
  }
  @media (max-width: 720px) {
    .graph-box { width: 100vw; margin-left: calc(50% - 50vw); height: 60vh; }
    .graph-controls button { min-width: 40px; min-height: 40px; }
    /* 범례는 한 줄 가로 스크롤. 오른쪽 끝을 옅게 해 더 있음을 알린다. */
    .map-toolbar { align-items: center; gap: 8px; }
    .map-toolbar .legend { flex-wrap: nowrap; gap: 4px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 28px), transparent); }
    .map-toolbar .legend::-webkit-scrollbar { display: none; }
    .map-toolbar .legend::after { flex: 0 0 24px; content: ""; }
    .map-toolbar .legend-item { flex: 0 0 auto; min-height: 36px; }
    .map-start { display: block; padding-top: 14px; }
    .map-start-hint { margin: 0; }
  }
  /* 손가락으로 누르는 기기에서는 범례와 확대 버튼을 44px로 키운다. 마우스 환경은 한 줄에 범례가 더 들어가도록 작게 둔다. */
  @media (pointer: coarse) {
    .legend-item, .map-toolbar .legend-item { min-height: 44px; }
    .graph-controls button { min-width: 44px; min-height: 44px; }
  }
</style>
<script src="../../scripts/map.ts"></script>
