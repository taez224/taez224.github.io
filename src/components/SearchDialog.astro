---
import { pixelIcon } from '../lib/pixel-icons.ts';
import { withBase } from '../lib/format.ts';
---
<dialog id="search" class="search" aria-labelledby="search-title" data-index={withBase('/data/search.json')}>
  <form class="search-head">
    <h2 id="search-title" class="visually-hidden">전체 검색</h2>
    <input id="search-input" type="search" aria-label="검색어" placeholder="노트·글·개발·책 검색" autocomplete="off" />
    <button type="button" class="search-close" aria-label="검색 닫기" title="검색 닫기 (Esc)"><Fragment set:html={pixelIcon('close')} /></button>
  </form>
  <p id="search-status" class="search-status" role="status">제목·요약·본문으로 찾아보세요.</p>
  <div id="search-results" class="search-results"></div>
</dialog>
<script src="../scripts/search.ts"></script>
