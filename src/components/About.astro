---
import Contacts from './Contacts.astro';
interface Props { about: string; contacts: { name: string; url: string; icon?: string }[]; entryUrl: string; aboutUrl?: string }
const { about, contacts, entryUrl, aboutUrl } = Astro.props;
---
<div class="about">
  <h1 class="display">Thinking Garden</h1>
  <p>{about}</p>
  <div class="about-actions">
    <a class="btn" href={entryUrl}>생각의 정원으로 <span aria-hidden="true">→</span></a>
    {aboutUrl && <a class="making-of" href={aboutUrl}>이 위키에 대해 <span aria-hidden="true">→</span></a>}
  </div>
  <Contacts contacts={contacts} />
</div>
<style>
  .about { display: flex; flex-direction: column; gap: 18px; }
  .about h1 { margin: 0; font-size: 32px; line-height: 1.45; }
  .about p { margin: 0; color: var(--muted); font-size: var(--t-body); line-height: 1.8; }
  .about-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 10px; }
  /* .btn은 플렉스라 글자 사이 공백이 사라진다. 화살표가 있는 다른 버튼과 같은 간격을 둔다. */
  .about-actions .btn { gap: 14px; }
  /* 인라인으로 두어 글자·공백·화살표 아래에 밑줄 하나가 이어지게 한다. 플렉스로 두면 항목마다 밑줄이 따로 그려져 간격에서 끊긴다. */
  .making-of { font-size: var(--t-side); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; }
  @media (max-width: 720px) {
    .about { gap: 14px; }
    .about-actions { margin-top: 6px; }
  }
</style>
