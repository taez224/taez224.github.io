---
import Contacts from './Contacts.astro';
interface Props { about: string; contacts: { name: string; url: string; icon?: string }[]; aboutUrl?: string; mapUrl?: string }
const { about, contacts, aboutUrl, mapUrl } = Astro.props;
---
<div class="about">
  <h1 class="display">Thinking Garden</h1>
  <p>{about}</p>
  <div class="about-actions">
    {aboutUrl && <a class="hero-link" href={aboutUrl}>이 위키에 대해</a>}
    {mapUrl && <a class="hero-link" href={mapUrl}>생각 지도 보기</a>}
  </div>
  <Contacts contacts={contacts} />
</div>
<style>
  .about { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .about h1 { margin: 0; font-size: var(--t-hero); line-height: 1.45; }
  .about p { margin: 0; color: var(--muted); font-size: var(--t-body); line-height: 1.85; }
  .about-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 6px; }
  .hero-link { font-size: var(--t-meta); text-decoration: underline; text-decoration-color: var(--link-underline); text-underline-offset: 4px; }
  @media (hover: hover) { .hero-link:hover { text-decoration-color: var(--ink); } }
  @media (max-width: 720px) {
    .about { gap: 14px; }
    .about-actions { column-gap: 12px; }
    /* 첫 화면에서 대표 글을 만날 공간을 남긴다. 프로필 링크는 바닥글에서 계속 제공한다. */
    .about :global(.contacts) { display: none; }
  }
  /* 위아래로 넓힌 영역이 다음 요소에 닿지 않도록 넓힌 만큼 아래 여백을 둔다. 휴대폰 폭에서는 바로 아래가 지도 그림이라,
     닿으면 그림의 윗변을 눌렀는데 소개 페이지가 열린다. */
  @media (pointer: coarse) { .hero-link { padding-block: 12px; margin-block: -12px; } .about-actions { margin-bottom: 12px; } }
</style>
