---
import Contacts from './Contacts.astro';
interface Props { about: string; contacts: { name: string; url: string; icon?: string }[]; mapUrl: string; aboutUrl?: string }
const { about, contacts, mapUrl, aboutUrl } = Astro.props;
---
<div class="about">
  <h1 class="display">Thinking Garden</h1>
  <p>{about}</p>
  <div class="about-actions">
    {/* 둘러보는 두 길을 같은 무게로 한 줄에 둔다. 채운 버튼을 두면 화면에서 가장 강한 신호가 읽기가 아닌 곳을 가리키므로,
       홈의 주요 행동 자리는 아래의 대표 글에 맡긴다. 지도로 가는 길을 여기 두는 것은 넓은 화면에서 그림이 살아 있는 지도로 바뀌어 지도 자체로 가는 길이 사라지기 때문이다. */}
    <a class="hero-link" href={mapUrl}>생각 지도 보기</a>
    {aboutUrl && <a class="hero-link" href={aboutUrl}>이 위키에 대해</a>}
  </div>
  <Contacts contacts={contacts} />
</div>
<style>
  .about { display: flex; flex-direction: column; gap: 18px; }
  .about h1 { margin: 0; font-size: var(--t-hero); line-height: 1.45; }
  .about p { margin: 0; color: var(--muted); font-size: var(--t-body); line-height: 1.85; }
  .about-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 10px; }
  /* 인라인으로 두어 밑줄이 글자에 붙게 한다. 플렉스로 두면 항목마다 밑줄이 따로 그려져 간격에서 끊긴다. */
  .hero-link { font-size: var(--t-side); text-decoration: underline; text-decoration-color: var(--link-underline); text-underline-offset: 4px; }
  @media (hover: hover) { .hero-link:hover { text-decoration-color: var(--ink); } }
  @media (max-width: 720px) {
    .about { gap: 14px; }
    .about-actions { margin-top: 6px; column-gap: 16px; }
    /* 모바일 첫 화면은 글과 지도 탐색에 집중한다. 연락처는 모든 페이지의 바닥글에 있다. */
    .about :global(.contacts) { display: none; }
  }
  /* 위아래로 넓힌 영역이 다음 요소에 닿지 않도록 넓힌 만큼 아래 여백을 둔다. 휴대폰 폭에서는 바로 아래가 지도 그림이라,
     닿으면 그림의 윗변을 눌렀는데 소개 페이지가 열린다. */
  @media (pointer: coarse) { .hero-link { padding-block: 12px; margin-block: -12px; } .about-actions { margin-bottom: 12px; } }
</style>
