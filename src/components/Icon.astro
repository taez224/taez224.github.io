---
const { name } = Astro.props;
const stroke = 'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"';
---
{name === 'out' && <svg viewBox="0 0 14 14" aria-hidden="true" set:html={`<g ${stroke}><circle cx="4" cy="7" r="2"></circle><path d="M6 7h6m-2.5-2.5L12 7l-2.5 2.5"></path></g>`} />}
{name === 'in' && <svg viewBox="0 0 14 14" aria-hidden="true" set:html={`<g ${stroke}><circle cx="10" cy="7" r="2"></circle><path d="M8 7H2m2.5-2.5L2 7l2.5 2.5"></path></g>`} />}
