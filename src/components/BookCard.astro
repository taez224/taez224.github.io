---
import { formatDate } from '../lib/format.mjs';
const { book } = Astro.props;
---
<article class="book" id={`book-${book.slug}`} data-status={book.status}>
  <div class="cover">{book.coverUrl ? <img src={book.coverUrl} alt="" loading="lazy" width="88" height="128" /> : <div class="placeholder">{book.title}</div>}</div>
  <div class="content">
    <div class="heading"><h3>{book.title}</h3>{book.rate ? <span class="rating"><span class="display value">{book.rate.toFixed(1)}</span><span class="meta">/ 5</span></span> : null}</div>
    {book.note && <p class="note">{book.note}</p>}
    <div class="meta">{[book.author, book.publisher].filter(Boolean).join(' · ')}<br />{book.status}{book.finishDate && <> · {formatDate(book.finishDate)}</>}</div>
  </div>
</article>
<style>
  .book { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 20px; align-items: start; scroll-margin-top: 110px; }
  .cover { width: 88px; height: 128px; }
  .cover img { width: 100%; height: 100%; object-fit: contain; object-position: top; }
  .placeholder { display: flex; align-items: center; height: 100%; padding: 10px; border-left: 3px solid var(--line); background: var(--paper-strong); color: var(--muted); font-size: var(--t-meta); line-height: 1.5; }
  .heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: baseline; margin-bottom: 10px; }
  .heading h3 { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.55; }
  .rating .value { font-size: 22px; color: var(--accent); }
  .note { margin: 0 0 14px; font-size: 16px; line-height: 1.75; }
  @media (max-width: 480px) { .book { grid-template-columns: 68px minmax(0, 1fr); gap: 14px; } .cover { width: 68px; height: 100px; } }
</style>
