---
import Shell from '../layouts/Shell.astro';
import { Image } from 'astro:assets';
import { getGarden } from '../lib/get-garden.ts';
import { cleanTitle, formatDate, kindLabel, withBase } from '../lib/format.ts';
import { articleMeta } from '../lib/seo.ts';
import FeedbackLink from './FeedbackLink.astro';

import type { NoteEntry, PublicNote } from '../lib/content-model.ts';
interface Props { entry: NoteEntry }
const { entry } = Astro.props;
const note = entry.data;
const title = cleanTitle(note.title);
const garden = await getGarden();
const byPath = new Map(garden.notes.map((item) => [item.path, item]));
const related = [...new Set([...note.outgoing, ...note.incoming])].filter((path) => path !== note.path).map((path) => byPath.get(path)).filter((item): item is PublicNote => item !== undefined);
---
<Shell title={title} description={note.summary} {...articleMeta(note)} feedback={false} active="posts">
  <article class="external-article">
    <div class="external-meta meta">
      <a href={note.publishedUrl} target="_blank" rel="noreferrer">{note.publication || note.externalPublisher} <span aria-hidden="true">↗</span></a>
      {note.published && <time datetime={note.published}>{formatDate(note.published)}</time>}
    </div>
    <h1 class="display">{title}</h1>
    {note.thumbnail && <figure class:list={['external-thumbnail', { 'is-soft': note.thumbnailStyle === 'soft' }]}>
      <Image src={note.thumbnail} alt="" width={480} widths={[480, 960]} sizes="(max-width: 520px) calc(100vw - 40px), 480px" format="webp" />
    </figure>}
    {note.summary && <p class="external-summary">{note.summary}</p>}
    <a class="btn read-original" href={note.publishedUrl} target="_blank" rel="noreferrer">전문 읽기 <span aria-hidden="true">↗</span></a>
    <p class="external-notice meta">{note.publication || note.externalPublisher}에 기고한 글입니다. 전문은 원문에서 읽을 수 있습니다.</p>
    {related.length > 0 && <section class="external-related" aria-labelledby="related-heading">
      <h2 id="related-heading" class="display">연결된 노트</h2>
      <ul>{related.map((item) => <li><a href={item.url}>{item.type === 'hub' && <i class="hub-mark" aria-hidden="true"></i>}{cleanTitle(item.displayTitle || item.title)}</a><span class="meta">{kindLabel(item)}</span></li>)}</ul>
    </section>}
    {/* 글 끝 줄은 리더와 같다. 목록으로 돌아가는 링크가 왼쪽, 제보 링크가 오른쪽이다. */}
    <div class="article-end"><a class="back-to-posts" href={withBase('/posts/')}><span aria-hidden="true">←</span> 글 목록</a><FeedbackLink path={articleMeta(note).path} /></div>
  </article>
</Shell>
<style>
  .external-article { width: min(var(--s-reader-column), 100% - 2 * var(--s-page-gutter)); margin: 0 auto; padding: var(--s-page-top-reading) 0 var(--s-page-bottom); }
  .external-meta { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-bottom: 22px; }
  /* 노트 머리의 메타 줄과 같은 역할이다. 이 줄은 링크가 하나뿐이고 위는 페이지 여백, 아래는 제목까지 22px이라 12px씩 넓혀 44px을 채운다. */
  @media (pointer: coarse) { .external-meta a { padding-block: 12px; margin-block: -12px; } }
  h1 { margin: 0 0 26px; font-size: var(--t-title); line-height: 1.3; }
  .external-summary { margin: 0 0 28px; color: var(--muted); font-size: var(--t-lead); line-height: 1.8; }
  .read-original { gap: 14px; }
  .external-notice { margin: 14px 0 0; }
  .external-thumbnail { width: 100%; max-width: 480px; margin: 0 auto 28px; }
  .external-thumbnail :global(img) { display: block; width: auto; max-width: 100%; height: auto; max-height: 260px; margin: 0 auto; }
  .external-thumbnail.is-soft :global(img) {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 90%, transparent), linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 90%, transparent), linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent);
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  .external-related { margin-top: 52px; padding-top: 22px; border-top: 1px solid var(--line); }
  /* 줄 간격을 적지 않으면 본문의 1.85를 물려받아, 두 줄이 될 때 본문 제목(1.4)보다 벌어진다. */
  h2 { margin: 0 0 14px; font-size: var(--t-h3); line-height: 1.4; }
  ul { list-style: none; padding: 0; margin: 0; }
  /* 리더의 목록과 같은 규칙이다. 줄 전체를 제목 링크의 영역으로 덮어 글자 한 줄만 누를 수 있는 상태를 없앤다. */
  li { position: relative; display: flex; align-items: baseline; gap: 20px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  li a { flex: 1; line-height: 1.6; }
  li a::after { position: absolute; inset: 0; content: ""; }
  li .meta { flex-shrink: 0; }
  .article-end { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 24px; font-size: var(--t-side); }
  /* 오른쪽 끝으로 보내는 일은 링크의 왼쪽 여백이 맡는다. 줄 양쪽 정렬로 하면 링크가 둘째 줄로 내려갔을 때 혼자 왼쪽에 붙는다. */
  .article-end :global(.feedback-link) { margin-left: auto; }
  .back-to-posts { display: inline-flex; gap: 8px; margin-top: 34px; font-size: var(--t-side); }
  /* 위쪽 여백 34px 중 12px만 누르는 영역으로 옮긴다. 위 여백까지 -12px로 덮으면 앞 목록과 겹친다. */
  @media (pointer: coarse) { .back-to-posts { padding-block: 12px; margin-top: 22px; margin-bottom: -12px; } }
  /* 줄이 둘로 나뉘면 두 링크가 12px씩 넓힌 영역이 맞닿기만 하게 줄 사이를 24px로 벌린다. 리더의 글 끝 줄과 같다. */
  @media (pointer: coarse) { .article-end { row-gap: 24px; } .article-end :global(.feedback-link) { padding-block: 12px; margin-block: -12px; } }
  @media (max-width: 720px) {
    .external-thumbnail :global(img) { max-height: 220px; }
    .external-related { margin-top: 40px; }
    li { gap: 12px; }
  }
</style>
