---
import type { CollectionNote } from '../lib/content-model.ts';
import type { seriesNeighbors } from '../lib/note-nav.ts';
interface Props { note: CollectionNote; series: NonNullable<ReturnType<typeof seriesNeighbors>> }
const { note, series } = Astro.props;
---
  {series && series.total > 0 && <section class="list-block series-block">
    <div class="meta">연재<span class="count">{series.isHub ? series.total : `${series.position} / ${series.total}`}</span></div>
    {!series.isHub && (series.url ? <a class="series-hub" href={series.url}>{series.title}</a> : <span class="series-hub">{series.title}</span>)}
    <ol class="side-list series-list">{series.posts.map((post) => <li><a href={post.url} aria-current={post.path === note.path ? 'page' : undefined}>{post.title}</a></li>)}</ol>
  </section>}
<style>
.series-block { margin-top: 0; padding-top: 20px; border-top: 1px solid var(--line); border-bottom: 0; }
.series-hub { display: block; padding: 10px 0; }
.series-list { list-style: none; padding: 0; }
.series-list a { display: block; padding: 10px 0; min-height: 44px; font-size: var(--t-side); }
.series-list a[aria-current="page"] { font-weight: 600; }
</style>
