---
import { inlineJson, topicColor } from '../lib/format.ts';
import type { readingConnections } from '../lib/reading-connections.ts';
import type { PublicNote, TopicFold } from '../lib/content-model.ts';
import '../styles/reader-connections.css';
interface Props { note: PublicNote; connections: ReturnType<typeof readingConnections>; mapUrl: string; topicFold: TopicFold; graph?: boolean }
const { note, connections, mapUrl, topicFold, graph = true } = Astro.props;
const { neighbors, hubs, edges, headingId, headingTitle } = connections;
const nodes = [note, ...neighbors];
const showGraph = graph && neighbors.length > 2;
---
{(neighbors.length > 0 || hubs.length > 0) && <section class="reader-end-connections" aria-labelledby={neighbors.length ? headingId : undefined}>
  {neighbors.length > 0 && <header class="reader-related-header">
    <h2 class="reader-related-heading" id={headingId}>{headingTitle}</h2>
    {mapUrl && <a class="reader-map-link" href={mapUrl}><span class="reader-map-label">전체 지도</span><span aria-hidden="true">→</span></a>}
  </header>}
  {neighbors.length > 0 && <div class="reader-network compact-network" data-reader-network={showGraph || undefined} role="group" aria-label="이 글과 연결된 노트">
    {showGraph && <script type="application/json" data-reader-network-data is:inline set:html={inlineJson({ center: note.path, nodes: nodes.map(n => ({ id: n.path, topic: n.topic })), edges })} />}
    <svg aria-hidden="true"></svg>
    <div class="network-note current-note" data-node={note.path}><i style={`background:${topicColor(topicFold[note.topic] ?? note.topic)}`} aria-hidden="true"></i><span class="network-title"><span>이 글</span></span></div>
    {neighbors.map(n => <a class="network-note" href={n.url} data-node={n.path}><i style={`background:${topicColor(topicFold[n.topic] ?? n.topic)}`} aria-hidden="true"></i><span class="network-title"><span>{n.displayTitle}</span></span></a>)}
  </div>}
  {hubs.length > 0 && <nav class="reader-hub-context" aria-label="주제별로 더 읽기">
    <p class="reader-hub-label">주제별로 더 읽기</p>
    <div class="reader-hub-links">{hubs.flatMap(hub => (hub.sections.length ? hub.sections : [null]).map(section => <div class="reader-hub-row">
      <a class="reader-hub-name" href={hub.url}>{hub.title}</a>
      {section && <span class="reader-hub-destination"><span class="reader-hub-separator" aria-hidden="true">·</span><a class="reader-hub-section" href={`${hub.url}#${encodeURIComponent(section.id)}`}>{section.title}</a></span>}
    </div>))}</div>
  </nav>}
</section>}
