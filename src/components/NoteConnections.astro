---
import LocalGraph from './LocalGraph.astro';
import type { PublicNote, CollectionNote } from '../lib/content-model.ts';
import type { noteConnections } from '../lib/note-connections.ts';
// 묶음은 noteConnections가 만든 것을 그대로 쓴다. 좁은 화면의 탐색 판과 기준을 한 곳에 둔다.
interface Props { note: CollectionNote; outgoing: PublicNote[]; incoming: PublicNote[]; groups: ReturnType<typeof noteConnections>; mapUrl: string; graph?: boolean }
const { note, outgoing, incoming, groups, mapUrl, graph = true } = Astro.props;
const neighbors = [...new Map([...outgoing, ...incoming].map(n => [n.path, n])).values()];
const listed = groups.flatMap(group => group.items);
---
{neighbors.length > 0 && <section class="connection-view list-block" data-connections>
  <div class="connection-head">
    <div class="meta">연결된 글<span class="count">{graph ? neighbors.length : listed.length}</span></div>
    {graph && <div class="connection-switch" role="group" aria-label="연결 보기 방식" hidden>
      <button type="button" data-connection-mode="graph" aria-controls="connection-graph" aria-pressed="true">그래프</button>
      <button type="button" data-connection-mode="list" aria-controls="connection-list" aria-pressed="false">목록</button>
    </div>}
  </div>
  {graph && <div id="connection-graph" data-connection-graph hidden><LocalGraph note={note} outgoing={outgoing} incoming={incoming} /></div>}
  <div id="connection-list" data-connection-list>
    {listed.length < neighbors.length && <p class="meta">연재에 속한 글은 위 연재 목록에서 볼 수 있습니다.</p>}
    <div class:list={['scroll-list', { 'is-long': listed.length > 6 }]}><div class="side-list connection-list">
      {groups.map(group => <section class="connection-group">
        <h3>{group.label}<span class="count">{group.items.length}</span></h3>
        <ul class="connection-items">{group.items.map(n => <li>
          <a href={n.url}>{n.type === 'hub' && <i class="hub-mark" aria-hidden="true"></i>}{n.displayTitle}</a>
        </li>)}</ul>
      </section>)}
    </div></div>
  </div>
  {mapUrl && <div class="connection-map"><a href={mapUrl}>생각 지도에서 보기</a></div>}
</section>}
<style>
  .connection-view { padding: 20px 0; overflow-anchor: none; }
  .connection-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
  .connection-head>.meta { display: flex; align-items: baseline; gap: 7px; color: var(--ink); margin: 0; }
  .connection-switch { display: flex; gap: 12px; flex-shrink: 0; }
  .connection-switch button { appearance: none; border: 0; border-bottom: 2px solid transparent; background: none; padding: 5px 0; color: var(--muted); font: inherit; font-size: var(--t-meta); cursor: pointer; }
  .connection-switch button[aria-pressed="true"] { color: var(--ink); border-bottom-color: var(--ink); }
  .connection-switch button:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; }
  [hidden] { display: none !important; }
  .connection-list { margin: 18px 0 0; padding: 0; gap: 22px; }
  .connection-group h3 { display: flex; align-items: baseline; gap: 7px; margin: 0 0 6px; color: var(--muted); font: inherit; font-size: var(--t-meta); }
  .connection-items { list-style: none; margin: 0; padding: 0; }
  .connection-items li + li { margin-top: 6px; }
  .connection-list a { display: block; color: var(--ink); font-size: var(--t-side); line-height: 1.65; }
  .connection-map { margin-top: 10px; font-size: var(--t-meta); }
  .connection-view :global(.local-graph) { padding: 0; }
  .connection-view :global(.local-graph > .meta:first-child) { display: none; }
  @media (pointer: coarse) {
    .connection-switch button { min-height: 44px; padding: 8px 4px; }
    .connection-map a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
<script src="../scripts/connection-view.ts"></script>
