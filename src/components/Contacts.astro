---
// 브랜드 로고를 회색조로 눕혀 종이색 톤에 맞춘다. 색을 지워도 실루엣이 남아 어느 서비스인지 알아볼 수 있다.
// 로고를 모르는 독자를 위해 이름을 숨긴 이름(aria-label)과 툴팁(title)에 함께 둔다. 헤더 검색 버튼과 같은 방식이다.
// 상자는 40px(휴대폰 폭과 손가락으로 누르는 기기 44px)이라 20px 아이콘보다 크다. 손가락으로 누를 자리를 확보한다.
import { withBase } from '../lib/format.ts';
interface Props { contacts?: { name: string; url: string; icon?: string }[] }
const { contacts = [] } = Astro.props;
// 홈 소개와 바닥글이 모두 이 줄을 쓰므로 보일 목록은 여기서 한 번 정한다. 구조화 데이터(Shell의 sameAs)는 Velog까지 모두 싣는다.
const shown = contacts.filter((contact) => contact.name !== 'Velog' && contact.icon);
---
{shown.length > 0 && <div class="contacts">
  {shown.map((contact) => <a href={contact.url} target="_blank" rel="noreferrer" aria-label={contact.name} title={contact.name}>
    <img src={withBase(`/social/${contact.icon}`)} alt="" width="20" height="20" />
  </a>)}
</div>}
<style>
  .contacts { display: flex; align-items: center; gap: 4px; margin: 0 -8px; }
  /* 블렌드하는 Brunch 판이 투명한 조상 대신 실제 바탕과 섞이도록 링크에 같은 바탕을 둔다. */
  .contacts a { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 4px; background: var(--paper); transition: background .15s ease, transform .15s cubic-bezier(.23, 1, .32, 1); }
  :global(.site-footer) .contacts a { background: var(--accent-soft); }
  :global(.home-page .site-footer) .contacts a { background: var(--paper); }
  .contacts a:active { transform: scale(.97); }
  .contacts img { width: 20px; height: 20px; object-fit: contain; filter: grayscale(1); opacity: .7; transition: opacity .15s ease; }
  .contacts a:focus-visible img { opacity: 1; }
  /* Brunch 원본은 짙은 판 안의 흰 글자다. 판을 바탕에 섞고 글리프만 남겨 다른 로고와 무게를 맞춘다. */
  .contacts img[src$="/brunch.png"] { width: 28px; height: 28px; filter: grayscale(1) contrast(10) invert(1); mix-blend-mode: multiply; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .contacts img[src$="/github.svg"] { filter: grayscale(1) invert(1); }
    :global(:root:not([data-theme])) .contacts img[src$="/brunch.png"] { filter: grayscale(1) contrast(10); mix-blend-mode: screen; }
  }
  :global(:root[data-theme="dark"]) .contacts img[src$="/github.svg"] { filter: grayscale(1) invert(1); }
  :global(:root[data-theme="dark"]) .contacts img[src$="/brunch.png"] { filter: grayscale(1) contrast(10); mix-blend-mode: screen; }
  @media (hover: hover) { .contacts a:hover { background: var(--accent-soft); } .contacts a:hover img { opacity: 1; } }
  /* 바닥글 바탕이 호버 판과 같은 색(accent-soft)이라 거기서는 판이 보이지 않는다. 바닥글 안에서는 한 단계 짙은 구분선 색을 쓴다.
     밝은 화면에서는 더 어둡게, 어두운 화면에서는 더 밝게 올라와 다른 호버와 방향이 같다. 키보드 포커스는 전역 윤곽선 그대로다. */
  @media (hover: hover) { :global(.site-footer) .contacts a:hover { background: var(--line); } }
  /* 폭만 보면 태블릿 같은 넓은 터치 화면에서 40px에 머문다. 입력 방식도 함께 본다. */
  @media (max-width: 720px), (pointer: coarse) { .contacts a { width: 44px; height: 44px; } }
</style>
