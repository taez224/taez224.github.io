---
import LocalGraph from './LocalGraph.astro';
import Icon from './Icon.astro';
import type { PublicNote, CollectionNote } from '../lib/content-model.ts';
import type { seriesNeighbors } from '../lib/note-nav.ts';
interface Props { note: CollectionNote; headings: PublicNote['headings']; outgoing: PublicNote[]; incoming: PublicNote[]; mapUrl: string; series?: ReturnType<typeof seriesNeighbors> }
const { note, headings, outgoing, incoming, mapUrl, series = null } = Astro.props;
// 목차는 h2·h3. h3에는 자기 h2의 id를 달아 두고, 스크립트가 읽고 있는 절의 h3만 펼친다(JS 없이는 전부 보인다).
let section = '';
const toc = headings.filter((h) => h.level === 2 || h.level === 3).map((h) => { if (h.level === 2) section = h.id; return { ...h, parent: h.level === 3 ? section : '' }; });
const block = (label: string, icon: 'out' | 'in', items: PublicNote[]) => ({ label, icon, items, long: items.length > 6 });
// 연재 글의 참조·역참조는 대개 같은 연재의 다른 편과 허브이고, 위의 연재 블록이 이미 모두 보여 준다.
// 목록에서는 연재 블록에 있는 글을 빼고 비면 블록을 그리지 않는다. 로컬 그래프는 연결 방향을 보여 주므로 전체 이웃을 그린다.
const inSeriesBlock = new Set(series && series.total > 0 ? [series.url, ...series.posts.map((post) => post.url)].filter(Boolean) : []);
const outsideSeries = (items: PublicNote[]) => items.filter((item) => !inSeriesBlock.has(item.url));
const blocks = [block('참조', 'out', outsideSeries(outgoing)), block('역참조', 'in', outsideSeries(incoming))].filter((b) => b.items.length);
// 연결이 하나도 없으면 로컬 그래프는 "이 노트" 점 하나뿐이라 그리지 않는다. 지도에 있는 노트라면 지도로 가는 링크만 남긴다.
const hasNeighbors = outgoing.length + incoming.length > 0;
---
<aside class="note-side">
  {toc.length >= 2 && <div class:list={['rail-scroll', { 'is-long': toc.length > 10 }]}><nav class="rail" aria-label="목차">
    {toc.map((h) => <a href={`#${h.id}`} data-heading={h.id} data-parent={h.parent || undefined} class:list={[{ 'level-3': h.level === 3 }]}>{h.title}</a>)}
  </nav></div>}
  {series && series.total > 0 && <section class="list-block series-block">
    <div class="meta">연재<span class="count">{series.isHub ? series.total : `${series.position} / ${series.total}`}</span></div>
    {!series.isHub && (series.url ? <a class="series-hub" href={series.url}>{series.title}</a> : <span class="series-hub">{series.title}</span>)}
    <ol class="side-list series-list">{series.posts.map((post) => <li><a href={post.url} aria-current={post.path === note.path ? 'page' : undefined}>{post.title}</a></li>)}</ol>
  </section>}
  {hasNeighbors ? <LocalGraph note={note} outgoing={outgoing} incoming={incoming} mapUrl={mapUrl} /> : mapUrl && <div class="map-link"><a href={mapUrl}>생각 지도에서 보기</a></div>}
  {blocks.map((b) => <section class="list-block">
    <div class="meta"><Icon name={b.icon} />{b.label}<span class="count">{b.items.length}</span></div>
    <div class:list={['scroll-list', { 'is-long': b.long }]}>
      <ul class="side-list">{b.items.map((n) => <li><a href={n.url}>{n.type === 'hub' && <i class="hub-mark" aria-hidden="true"></i>}{n.displayTitle}</a></li>)}</ul>
    </div>
  </section>)}
</aside>
<style>
  /* 사이드바의 리듬: 블록마다 위에 선 하나, 여백은 20px 한 값. 블록이 자기 아래 선을 따로 갖지 않는다(연재 아래 선과 그래프 위 선이 겹치고 그래프 아래가 유독 넓던 문제).
     목차는 왼쪽 레일이 경계라 위 선을 두지 않는다. 목차가 없는 글에서도 첫 블록이 위 선으로 시작해야 제목 옆에 떠 보이지 않는다. */
  .note-side { display: flex; flex-direction: column; }
  /* 로컬 그래프는 다른 컴포넌트의 루트라 스코프 속성이 없다. :global로 두어야 그래프에도 선이 붙는다. */
  .note-side > :global(:not(.rail-scroll)) { border-top: 1px solid var(--line); }
  .rail-scroll { padding-bottom: 24px; }
  .note-side .list-block { padding: 20px 0; border-bottom: 0; }
  .map-link { padding: 20px 0; font-size: var(--t-meta); }
  .rail { display: flex; flex-direction: column; border-left: 2px solid var(--line); }
  /* 목차가 길면(11개 이상) 목차만 안에서 스크롤한다. 로컬 그래프와 참조 목록은 그 아래에 그대로 보인다. 끝까지 내리면 페이드를 걷는다. */
  .rail-scroll { position: relative; }
  .rail-scroll.is-long .rail { max-height: 340px; overflow-y: auto; padding-right: 8px; scrollbar-width: thin; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { .rail-scroll.is-long .rail { scroll-behavior: auto; } }
  .rail-scroll.is-long::after { position: absolute; right: 0; bottom: 0; left: 0; height: 36px; pointer-events: none; background: linear-gradient(180deg, transparent 0%, var(--paper) 100%); content: ""; }
  .rail-scroll.is-long[data-at-end]::after { display: none; }
  .rail a { display: block; margin-left: -2px; padding: 5px 0 5px 16px; border-left: 2px solid transparent; color: var(--muted); font-size: var(--t-side); line-height: 1.5; }
  .rail a.level-3 { padding-left: 28px; font-size: var(--t-meta); }
  /* 현재 위치 레일은 이 노트의 주제색(NotePage가 --topic으로 준다). */
  .rail a[aria-current="location"] { border-left-color: var(--topic, var(--accent)); color: var(--ink); font-weight: 600; }
  @media (hover: hover) { .rail a:hover { color: var(--accent); text-decoration: none; } }
  /* 연재 블록: 접기·스크롤·서수 없이 편 목록 전체. 현재 편은 색과 굵기 하나로만 표시한다. */
  .series-hub { display: block; margin: 4px 0 6px; color: var(--muted); font-size: var(--t-meta); }
  @media (hover: hover) { .series-hub:hover { color: var(--accent); } }
  .series-list { margin: 0; padding: 0; list-style: none; }
  .series-list a[aria-current="page"] { color: var(--accent); font-weight: 600; }
  /* 로컬 그래프의 노드에 마우스를 올리거나 포커스하면 같은 노트의 줄을 링크 호버와 같은 밑줄로 강조한다(local-graph.ts). */
  .side-list a.is-linked { text-decoration: underline; text-underline-offset: 4px; }
  @media (pointer: coarse) {
    .rail a { padding-block: calc((44px - 1.5em) / 2); }
    .series-hub { padding-block: 10px; margin-block: -6px -4px; }
  }
</style>
<script src="../scripts/toc.ts"></script>
<script>
  import { setupScrollFades } from '../scripts/scroll-fades.ts';
  const sidebar = document.querySelector('.note-side');
  if (sidebar) setupScrollFades(sidebar);
</script>
