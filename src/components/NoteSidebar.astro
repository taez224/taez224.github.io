---
import type { PublicNote, CollectionNote } from '../lib/content-model.ts';
import type { seriesNeighbors } from '../lib/note-nav.ts';
import SeriesContents from './SeriesContents.astro';
import FeedbackLink from './FeedbackLink.astro';
interface Props { headings: PublicNote['headings']; note: CollectionNote; series: ReturnType<typeof seriesNeighbors>; feedbackPath: string }
const { headings, note, series, feedbackPath } = Astro.props;
let section = '';
const toc = headings.filter(h => h.level === 2 || h.level === 3).map(h => { if (h.level === 2) section = h.id; return { ...h, parent: h.level === 3 ? section : '' }; });
---
<aside class:list={["note-side", { "has-series": series && series.total > 0 }]}>
  {toc.length >= 2 && <div class="rail-scroll"><nav class="rail" aria-label="목차">
    {toc.map(h => <a href={`#${h.id}`} data-heading={h.id} data-parent={h.parent || undefined} class:list={[{ 'level-3': h.level === 3 }]}>{h.title}</a>)}
  </nav></div>}
  {toc.length >= 2 && <div class="rail-feedback"><FeedbackLink path={feedbackPath} /></div>}
  {series && <SeriesContents note={note} series={series} />}
</aside>
<style>
  .rail-scroll { padding-bottom: 12px; }
  .rail-feedback { padding: 0 0 22px 16px; font-size: var(--t-meta); line-height: 1.5; }
  .rail-feedback :global(.feedback-link) { color: var(--muted); }
  @media (hover: hover) { .rail-feedback :global(.feedback-link:hover) { color: var(--accent); } }
  @media (pointer: coarse) { .rail-feedback :global(.feedback-link) { display: inline-block; padding-block: calc((44px - 1.5em) / 2); margin-block: -12px calc((1.5em - 44px) / 2); } }
  .rail { display: flex; flex-direction: column; }
  .rail a { display: block; padding: 5px 0 5px 16px; border-left: 2px solid var(--line); color: var(--muted); font-size: var(--t-side); line-height: 1.5; }
  .rail a.level-3 { padding-left: 28px; font-size: var(--t-meta); }
  /* 현재 위치 레일은 이 노트의 주제색(NotePage가 --topic으로 준다). */
  .rail a[aria-current="location"] { border-left-color: var(--topic, var(--accent)); color: var(--ink); font-weight: 600; }
  @media (hover: hover) { .rail a:hover { color: var(--accent); text-decoration: none; } }

  .note-side[data-sidebar-overflow]::after { content: ''; display: block; position: sticky; bottom: 0; height: 24px; margin-top: -24px; pointer-events: none; background: linear-gradient(to bottom, transparent, var(--paper)); }
  .note-side:has(:focus-visible)::after { opacity: 0; }
  @media (pointer: coarse) { .rail a { padding-block: calc((44px - 1.5em) / 2); } }
</style>
<script src="../scripts/toc.ts"></script>
<script>
import { setupSidebarFade } from '../scripts/scroll-fades.ts';
const sidebar = document.querySelector<HTMLElement>('.note-side');
if (sidebar) setupSidebarFade(sidebar);
</script>
