---
import { render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import NoteSidebar from './NoteSidebar.astro';
import ArticleBody from './ArticleBody.astro';
import FeedbackLink from './FeedbackLink.astro';
import { getGarden } from '../lib/get-garden.ts';
import { formatDate, displayTag, withBase, cleanTitle, topicColor } from '../lib/format.ts';
import { parentLink, seriesNeighbors } from '../lib/note-nav.ts';
import { articleMeta } from '../lib/seo.ts';
import { pixelIcon } from '../lib/pixel-icons.ts';
import '../styles/body.css';
import type { NoteEntry, PublicNote } from '../lib/content-model.ts';
interface Props { entry: NoteEntry }
const { entry } = Astro.props;
const note = entry.data;
const mobileToc = note.headings.filter((heading) => heading.level === 2 || heading.level === 3);
const title = cleanTitle(note.title); // 허브 노트의 🗺 같은 이모지는 리더 제목·문서 제목에서 뺀다
const { Content } = await render(entry);
const garden = await getGarden();
const byPath = new Map(garden.notes.map((n) => [n.path, n]));
const resolve = (paths: string[]): PublicNote[] => paths.map((p) => byPath.get(p)).filter((note): note is PublicNote => note !== undefined);
const outgoing = resolve(note.outgoing);
const incoming = resolve(note.incoming);
const mapNode = garden.nodes.find((node) => node.path === note.path);
const mapUrl = mapNode ? withBase(`/map/?node=${encodeURIComponent(mapNode.mapKey)}`) : '';
// 주제 점 색은 지도와 같다. 노드가 적어 기타로 접힌 주제는 여기서도 기타 색(garden.topicFold).
const topicFold = garden.topicFold ?? {};
const topics = note.publicTags.slice(0, 2).map((tag) => { const head = tag.split('/')[0]; return { label: displayTag(tag), color: topicColor(topicFold[head] ?? head) }; });
const parent = parentLink(note, mapNode?.mapKey);
const parentUrl = withBase(parent.path);
const series = note.kind === 'blog' ? seriesNeighbors(note, garden.blog.series) : null;
const hasSeriesNav = series && (series.prev || series.next);
// 노트(Slipbox)는 사이드바의 "생각 지도에서 보기"가 같은 곳으로 가므로 페이지 끝에 목록 링크를 두지 않는다.
// 사이드바는 모바일에서도 보이므로 여기서 한 번 더 두면 같은 링크가 두 개가 된다.
const endLink = note.kind === 'slipbox' ? null : parent.listLabel;
// 제보 링크는 읽는 도중(넓은 화면은 목차 아래, 한 열 화면은 목차 판의 제목 줄)과 다 읽은 뒤(글 끝 줄)에 닿는다.
// 세 자리가 같은 주소를 폼에 채운다.
const feedbackPath = articleMeta(note).path;
---
<Shell title={title} description={note.summary} {...articleMeta(note)} updated={note.updated || null} feedback={false} active={note.kind === 'blog' ? 'posts' : note.kind === 'development' ? 'dev' : 'map'}>
  <div class="wrap note-view" style={`--topic:${topicColor(note.topic)}`}>
    <article class="note-article">
      <div class="meta note-meta">
        <a class="kicker" href={parentUrl}>{parent.label}</a>
        {note.type === 'hub' && <span><i class="hub-mark" aria-hidden="true"></i>허브</span>}
        <span class="note-dates">
          {note.updated && `${note.published ? (note.kind === 'blog' ? '발행' : '공개') : '작성'} `}<time datetime={note.date}>{formatDate(note.date)}</time>
          {note.updated && <span class="modified-date">수정 <time datetime={note.updated}>{formatDate(note.updated)}</time></span>}
        </span>
        {note.readingMinutes > 0 && <span>{note.readingMinutes}분</span>}
        {topics.map((t) => <span><i class="topic-dot" style={`background:${t.color}`} aria-hidden="true"></i>{t.label}</span>)}
        {note.publishedUrl && <a href={note.publishedUrl} target="_blank" rel="noreferrer">{note.publication || '원문'}에서 읽기 ↗</a>}
      </div>
      <h1 class="display note-title">{title}</h1>
      {note.kind === 'development' && note.summary?.trim() && <p class="note-lead">{note.summary}</p>}
      {mobileToc.length >= 2 && <details class="mobile-toc">
        <summary>목차</summary>
        <nav aria-label="목차">{mobileToc.map((heading) => <a class:list={[{ 'level-3': heading.level === 3 }]} href={`#${heading.id}`}>{heading.title}</a>)}</nav>
      </details>}
      {series?.isHub && series.first && <nav class="series-start" aria-label="연재 시작">
        <div><span class="meta">공개된 글 {series.total}편</span><p>{series.first.title}</p></div>
        <a class="btn" href={series.first.url}>1편부터 읽기</a>
      </nav>}
      <div class="body">{note.articleCards?.length
        ? <ArticleBody html={byPath.get(note.path)!.bodyHtml} cards={note.articleCards} notes={garden.notes} />
        : <Content />}</div>
      {series && hasSeriesNav && <nav class:list={['note-end', 'series-links', { 'is-single': !series.prev || !series.next }]} aria-label="이어서 읽기">
        {series.prev && <a class="series-link" href={series.prev.url}><span class="series-direction"><span aria-hidden="true">←</span> 이전 편</span><span class="series-title">{series.prev.title}</span></a>}
        {series.next && <a class="series-link is-next" href={series.next.url}><span class="series-direction">{series.isHub ? '1편부터 읽기' : '다음 편'} <span aria-hidden="true">→</span></span><span class="series-title">{series.next.title}</span></a>}
      </nav>}
    </article>
    <NoteSidebar note={note} headings={note.headings} outgoing={outgoing} incoming={incoming} mapUrl={mapUrl} series={series} feedbackPath={feedbackPath} />
    {/* 글 끝 줄: 목록으로 돌아가는 링크와 제보 링크. 사이트 소개 링크는 모든 페이지의 바닥글에 있어 여기에 두지 않는다.
       목록 링크가 없는 생각 노트는 제보 링크만 왼쪽에 둔다. */}
    <footer class="note-footer">{endLink && <a href={parentUrl}><span aria-hidden="true">←</span> {endLink}</a>}<FeedbackLink path={feedbackPath} /></footer>
  </div>
  {/* 한 열 화면에서는 목차가 글 맨 위에 접혀 있어, 읽는 도중 다른 절로 가려면 맨 위까지 올라가야 한다. 접힌 목차가 화면을 벗어나면
     이 버튼이 나타나 탭 두 번으로 절을 옮긴다. 아래 막대는 본문을 읽은 만큼 찬다. 스크립트(toc-button.ts)가 hidden을 푼다. */}
  {mobileToc.length >= 2 && <>
    <button type="button" class="toc-button" popovertarget="toc-sheet" aria-label="목차" title="목차" data-toc-button hidden><Fragment set:html={pixelIcon('contents')} /><span class="toc-progress" aria-hidden="true"></span></button>
    <div id="toc-sheet" class="toc-sheet" popover>
      <div class="toc-head"><span class="meta">목차</span><FeedbackLink path={feedbackPath} /></div>
      <nav class="toc-scroll" aria-label="목차"><div class="toc-rail">{mobileToc.map((heading) => <a class:list={[{ 'level-3': heading.level === 3 }]} href={`#${heading.id}`} data-toc-target={heading.id}>{heading.title}</a>)}</div></nav>
    </div>
  </>}
</Shell>
<style is:global>
  /* 사이드바는 본문 옆 100px에 둔다. 오른쪽 끝을 헤더에 맞추면 본문과 150px 떨어져 따로 놓인 것처럼 보였다.
     창이 좁아지면 본문보다 간격이 먼저 줄도록, 본문과 사이드바를 뺀 남는 폭을 간격으로 쓰되 40~100px 안에 둔다. */
  .note-view { display: grid; grid-template-columns: minmax(0, var(--s-reader-column)) var(--s-sidebar); justify-content: start; gap: var(--s-column-gap) clamp(var(--s-column-gap), 100% - var(--s-reader-column) - var(--s-sidebar), var(--s-reader-gap)); align-items: start; padding: var(--s-page-top-reading) 0 var(--s-page-bottom); }
  .note-side { position: sticky; top: 100px; max-height: calc(100dvh - 120px); overflow-y: auto; padding-top: 82px; scrollbar-gutter: stable; }
  .note-view > .note-side { grid-column: 2; grid-row: 1 / span 2; }
  /* 글 끝 한 줄: 목록으로 돌아가는 링크와 제보 링크. 사이트 소개는 모든 페이지의 바닥글이 맡는다.
     본문 밖에 두어 한 열에서는 연결 목록 뒤에 온다. 두 열에서는 본문 바로 아래가 된다. */
  .note-footer { grid-column: 1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 24px; padding-top: 24px; border-top: 1px solid var(--line); font-size: var(--t-side); }
  /* 목록 링크가 있으면 제보 링크를 줄의 오른쪽 끝으로 보낸다. 혼자일 때는 왼쪽에서 시작한다. */
  .note-footer .feedback-link:not(:only-child) { margin-left: auto; }
  .note-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  /* 구분점은 항목의 앞에 붙인다. 별도 span이면 좁은 화면에서 줄 끝에 점만 남고 항목은 다음 줄로 넘어간다. */
  .note-meta > * + *::before { content: '·'; margin-right: 8px; }
  /* 두 날짜는 함께 읽히게 묶는다. 공간이 부족하면 날짜 묶음이나 다른 메타 항목이 통째로 다음 줄로 간다. */
  .note-dates { white-space: nowrap; }
  .modified-date::before { content: '·'; margin: 0 8px; }
  .note-meta .kicker { color: var(--accent); }
  /* 제목 아래 요약: 본문의 요약 콜아웃과 같은 명조 활자를 쓴다. 인쇄물의 리드문처럼 선이나 판 없이 활자만으로 제목·본문과 구분한다.
     좁은 화면에서는 바로 뒤에 목차의 위 선이 오므로 아래 선도 두지 않는다. */
  .note-lead { margin: -12px 0 36px; color: var(--ink); font-family: var(--display); font-size: var(--t-lead); line-height: 1.65; letter-spacing: -.01em; }
  /* 이전·다음 편 카드는 테두리가 있어 본문과 구분된다. 구분선은 아래 페이지 끝 줄에만 둔다. */
  .note-end { margin-top: 56px; }
  /* 연재 허브의 1편 안내는 주석이 아니라 이동 안내라, 페이지 끝의 이전·다음 편 카드와 같은 1px 테두리와 4px 모서리를 쓴다. */
  .series-start { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin: -12px 0 36px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 4px; }
  .series-start p { margin: 4px 0 0; font-size: var(--t-summary); line-height: 1.75; }
  .series-start .btn { flex-shrink: 0; gap: 14px; }
  /* 이전·다음 편 카드: 둘 다 얇은 선과 종이색만 쓴다. 채움이나 강조 테두리는 호버·포커스에서만 나타나 카드가 본문 톤에서 튀지 않는다. */
  .series-links { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
  .series-links.is-single { grid-template-columns: 1fr; }
  .series-link { display: flex; flex-direction: column; gap: 6px; padding: 14px 18px; border: 1px solid var(--line); border-radius: 4px; background: transparent; color: var(--ink); transition: border-color .15s ease, background-color .15s ease; }
  .series-link:focus-visible { border-color: var(--accent); background: var(--accent-soft); outline: none; }
  @media (hover: hover) { .series-link:hover { border-color: var(--accent); background: var(--accent-soft); text-decoration: none; } }
  .series-link.is-next { align-items: flex-end; text-align: right; }
  .series-direction { color: var(--muted); font-size: var(--t-meta); }
  /* 제목은 소제목이 아니라 내비게이션이므로 사이드바 목록과 같은 고딕 15px */
  .series-title { font-size: var(--t-ui); font-weight: 600; line-height: 1.5; }
  .note-title { margin: 0 0 var(--s-title-gap); font-size: var(--t-title); line-height: 1.3; letter-spacing: -.03em; text-wrap: balance; }
  .mobile-toc { display: none; }
  /* 목차 버튼과 판은 두 열 화면에서 쓰지 않는다. 사이드바의 목차가 늘 보인다. */
  .toc-button, .toc-sheet { display: none; }
  @media (max-width: 1000px) {
    .note-view { grid-template-columns: minmax(0, var(--s-reader-column)); gap: 20px; }
    /* 한 열에서는 본문과 연결 목록을 먼저 읽고, 목록 링크와 사이트 소개가 있는 페이지 끝 줄로 이동한다. */
    .note-view > .note-side { grid-column: 1; grid-row: auto; }
    .note-side { position: static; max-height: none; overflow: visible; padding-top: 0; } /* 본문과의 경계선은 목차를 뺀 첫 블록의 위 선이 맡는다 */
    .note-side .rail-scroll { display: none; }
    .mobile-toc { display: block; margin: -8px 0 28px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    /* 펼침 표시는 브라우저 기본 삼각형 대신 접히는 콜아웃과 같은 꺾쇠를 줄 오른쪽 끝에 둔다. */
    .mobile-toc summary { position: relative; padding: 11px 24px 11px 0; color: var(--muted); font-size: var(--t-side); list-style: none; cursor: pointer; }
    .mobile-toc summary::-webkit-details-marker { display: none; }
    .mobile-toc summary::after { position: absolute; top: calc(50% - 5px); right: 4px; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); transition: transform .15s cubic-bezier(.23, 1, .32, 1); content: ""; }
    .mobile-toc[open] summary::after { transform: translateY(4px) rotate(-135deg); }
    .mobile-toc nav { display: flex; flex-direction: column; gap: 4px; padding-bottom: 14px; }
    .mobile-toc nav a { padding: 5px 0; font-size: var(--t-side); line-height: 1.5; }
    .mobile-toc nav a.level-3 { padding-left: 16px; color: var(--muted); }
    /* 본문 위에 떠 있으므로 각주 판처럼 먹색 테두리로 경계를 보인다. 누르는 영역은 44px이다. */
    .toc-button { position: fixed; z-index: 30; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); display: grid; place-items: center; width: 44px; height: 44px; padding: 0; overflow: hidden; border: 1px solid var(--overlay-line); border-radius: 4px; background: var(--paper-strong); color: var(--ink); }
    .toc-button :global(svg) { display: block; width: 16px; height: 16px; }
    /* 막대는 읽은 정도를 대략 알린다. 숫자를 적지 않는 것은 초반·중간·끝 가운데 어디인지만 알면 되기 때문이다. */
    .toc-progress { position: absolute; right: 0; bottom: 0; left: 0; height: 3px; background: var(--line); }
    .toc-progress::after { position: absolute; inset: 0; background: var(--ink); transform: scaleX(var(--progress, 0)); transform-origin: left; content: ""; }
    .toc-sheet { position: fixed; inset: auto 16px calc(70px + env(safe-area-inset-bottom)) auto; width: min(320px, calc(100vw - 32px)); max-height: min(60vh, 420px); margin: 0; overflow: hidden; padding: 12px 16px 14px; border: 1px solid var(--overlay-line); border-radius: 6px; background: var(--paper-strong); color: var(--ink); }
    /* 제목 줄은 판에 남기고 목록만 스크롤한다. 판 전체를 스크롤하면 글 후반에서 열었을 때 현재 절까지 내려가면서 제목과 제보 링크가 위로 가려진다. */
    .toc-sheet:popover-open { display: flex; flex-direction: column; }
    .toc-head { display: flex; flex: none; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 8px; }
    .toc-head .feedback-link { font-size: var(--t-meta); white-space: nowrap; }
    /* 스크롤은 레일의 바깥 상자가 맡는다. 레일에 직접 걸면 현재 절의 막대가 레일의 왼쪽 선 위로 나가 있어 잘린다. */
    .toc-scroll { min-height: 0; overflow-y: auto; }
    .toc-sheet .toc-rail { display: flex; flex-direction: column; border-left: 2px solid var(--line); }
    .toc-sheet .toc-rail a { margin-left: -2px; padding: 7px 0 7px 14px; border-left: 2px solid transparent; color: var(--muted); font-size: var(--t-side); line-height: 1.5; }
    .toc-sheet .toc-rail a.level-3 { padding-left: 26px; font-size: var(--t-meta); }
    .toc-sheet .toc-rail a[aria-current="location"] { border-left-color: var(--topic, var(--accent)); color: var(--ink); font-weight: 600; }
  }
  @media (max-width: 720px) {
    /* 목차를 누르는 영역은 유지하고 제목·본문과의 바깥 여백만 줄인다. */
    .mobile-toc { margin: -12px 0 16px; }
    /* 목차 아래 선과 시작 카드 위 선이 붙지 않게 제목용 음수 여백을 이 조합에서만 푼다. */
    .mobile-toc + .series-start { margin-top: 0; }
    /* 이 폭에서는 제목 아래 여백이 28px로 줄어들어 위쪽 당김을 완화한다 */
    .note-lead { margin-top: -4px; }
    .note-end { margin-top: 40px; }
    .series-links { grid-template-columns: 1fr; gap: 12px; }
    .series-link.is-next { align-items: flex-start; text-align: left; }
    .series-start { align-items: flex-start; flex-direction: column; gap: 16px; }
  }
  /* 손가락으로 누르는 기기에서는 목차 줄을 44px로 넓힌다. 메타 줄과 페이지 끝의 짧은 링크는 위아래로만 누르는 영역을 넓히고
     같은 양의 음수 여백으로 되돌려 줄 높이가 바뀌지 않게 한다. */
  @media (pointer: coarse) {
    .mobile-toc nav { gap: 0; }
    .mobile-toc nav a { padding-block: calc((44px - 1.5em) / 2); }
    /* 메타 줄은 좁은 화면에서 두 줄로 접힌다. 줄 간격(8px)의 절반까지만 넓혀 두 줄의 누르는 영역이 맞닿기만 하게 한다.
       12px씩 넓히면 16px 겹치고, 겹친 자리에서는 뒤 줄이 이겨 앞 줄의 글자를 눌러도 다른 곳으로 간다.
       줄 간격을 24px로 벌려 44px을 채우는 대신 28.8px을 택했다. 그렇게 하면 같은 덩어리 안의 간격이 제목까지의 14px보다 넓어진다.
       페이지 끝 줄은 링크가 하나뿐이라 겹칠 일이 없어 44px을 채운다. */
    .note-meta a { padding-block: 4px; margin-block: -4px; }
    .note-footer a { padding-block: 12px; margin-block: -12px; }
    /* 글자를 키우거나 폭이 좁으면 제보 링크가 둘째 줄로 내려간다. 두 링크가 12px씩 넓힌 영역이 맞닿기만 하게 줄 사이를 24px로 벌린다.
       10px 그대로면 14px 겹쳐, 목록 링크의 아래쪽을 눌러도 제보 폼이 열린다. */
    .note-footer { row-gap: 24px; }
    /* 목차 판의 제보 링크는 위로는 판의 안쪽 여백(12px), 아래로는 목록까지의 간격(8px)까지만 넓힌다. 줄 높이 24px과 합쳐 44px이 되고 첫 목차 줄을 덮지 않는다. */
    .toc-head .feedback-link { padding-block: 12px 8px; margin-block: -12px -8px; }
  }
