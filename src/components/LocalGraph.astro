---
import { localGraphLayout } from './local-graph-layout.mjs';
import { offsetLine } from '../graph/engine.mjs';
import { cleanTitle } from '../lib/format.mjs';
const { note, outgoing, incoming, mapUrl } = Astro.props;
const width = 310, height = 190;
const layout = localGraphLayout(note, outgoing, incoming, { width, height });
const short = (title) => ([...title].length > 12 ? [...title].slice(0, 11).join('') + '…' : title);
// 서로 참조하는 이웃은 지도처럼 선 두 개를 벌려 그려 두 방향을 모두 보인다. 벌리는 폭도 지도 엔진과 같다.
const lines = (edge) => {
  if (edge.direction !== 'both') return [edge];
  const center = { x: edge.x1, y: edge.y1 }, neighbor = { x: edge.x2, y: edge.y2 };
  return [{ ...offsetLine(center, neighbor, 1), direction: 'out' }, { ...offsetLine(center, neighbor, -1), direction: 'in' }];
};
---
<div class="local-graph">
  <svg viewBox={`0 0 ${width} ${height}`} role="group" aria-label="이 노트의 연결">
    <g>
      {layout.edges.flatMap(lines).map((line) => <line class={`edge is-${line.direction}`} x1={line.x1} y1={line.y1} x2={line.x2} y2={line.y2} />)}
      {layout.nodes.map((node) => node.current
        ? <g class="node is-current">
            <circle cx={node.x} cy={node.y} r="16" class="ring" />
            <circle cx={node.x} cy={node.y} r="9" fill={node.color} />
            <text x={node.x} y={node.y + 29} text-anchor="middle">이 노트</text>
          </g>
        : <a class="node" href={node.url} aria-label={cleanTitle(node.title)}>
            <circle cx={node.x} cy={node.y} r="14" fill="transparent" />
            <circle cx={node.x} cy={node.y} r="6" fill={node.color} />
            <text class="label-short" x={node.x} y={node.y + 22} text-anchor="middle">{short(cleanTitle(node.title))}</text>
          </a>)}
    </g>
  </svg>
  <div class="local-graph-tools">
    {mapUrl && <a href={mapUrl}>생각 지도에서 보기</a>}
  </div>
  {layout.hidden > 0 && <p class="meta">가까운 연결 {layout.nodes.length - 1}개만 그렸습니다. 전체는 아래 목록에 있습니다.</p>}
</div>
<style>
  /* 위아래 선은 사이드바가 블록 사이에 긋는다. 여기서는 그림 앞뒤 여백만 둔다. */
  .local-graph { padding: 14px 0 20px; }
  .local-graph svg { display: block; width: 100%; height: 190px; overflow: visible; }
  .local-graph svg:focus, .local-graph svg:focus-visible { outline: none; }
  .edge { stroke: var(--accent); stroke-width: 1.2; stroke-opacity: .75; }
  .edge.is-in { stroke-dasharray: 5 4; }
  .node circle { stroke: var(--paper); stroke-width: 2.5; }
  .node .ring { fill: none; stroke: var(--accent); stroke-width: 1.2; stroke-opacity: .65; }
  .node text { font-family: var(--sans); font-size: 11px; fill: var(--ink); paint-order: stroke; stroke: var(--paper); stroke-width: 3.5px; stroke-linejoin: round; pointer-events: none; }
  .node.is-current text { font-weight: 600; }
  a.node { cursor: pointer; outline: none; }
  a.node:hover circle:last-of-type, a.node:focus-visible circle:last-of-type { stroke: var(--accent); }
  .local-graph-tools { display: flex; align-items: center; gap: 6px; margin-top: 10px; }
  .local-graph-tools a { font-size: var(--t-meta); }
</style>
