---
import { localGraphLayout } from './local-graph-layout.ts';
import { offsetLine } from '../graph/engine.ts';
import { cleanTitle } from '../lib/format.ts';
import type { PublicNote, CollectionNote } from '../lib/content-model.ts';
interface Props { note: PublicNote | CollectionNote; outgoing: PublicNote[]; incoming: PublicNote[]; mapUrl?: string }
const { note, outgoing, incoming, mapUrl } = Astro.props;
const width = 310, height = 190;
const layout = localGraphLayout(note, outgoing, incoming, { width, height });
// 블록 제목의 수는 그린 이웃이 아니라 전체 이웃이다. 서로 참조하는 노트는 한 번만 센다.
const neighborCount = layout.nodes.length - 1 + layout.hidden;
// 서로 참조하는 이웃은 지도처럼 선 두 개를 벌려 그려 두 방향을 모두 보인다. 벌리는 폭도 지도 엔진과 같다.
const lines = (edge: { x1: number; y1: number; x2: number; y2: number; direction: string }) => {
  if (edge.direction !== 'both') return [edge];
  const center = { x: edge.x1, y: edge.y1 }, neighbor = { x: edge.x2, y: edge.y2 };
  return [{ ...offsetLine(center, neighbor, 1), direction: 'out' }, { ...offsetLine(center, neighbor, -1), direction: 'in' }];
};
---
<div class="local-graph list-block">
  <div class="meta">연결<span class="count">{neighborCount}</span></div>
  <svg viewBox={`0 0 ${width} ${height}`} role="group" aria-label="이 노트의 연결">
    <g>
      {layout.edges.flatMap(lines).map((line) => <line class={`edge is-${line.direction}`} x1={line.x1} y1={line.y1} x2={line.x2} y2={line.y2} />)}
      {layout.nodes.map((node) => node.current
        ? <g class="node is-current">
            <circle cx={node.x} cy={node.y} r="16" class="ring" />
            <circle cx={node.x} cy={node.y} r="9" fill={node.color} />
            <text x={node.x} y={node.y + 29} text-anchor="middle">이 노트</text>
          </g>
        : <a class="node" href={node.url} aria-label={cleanTitle(node.title)}>
            {/* 제목은 단어 경계에서 두 줄까지 줄여 보이고(local-graph-layout.ts), 전체 제목은 툴팁(title)과 목록의 같은 줄이 보여 준다.
                링크 이름은 aria-label이 준다. 목록의 같은 줄은 호버·포커스에서 함께 강조된다(local-graph.ts). */}
            <title>{cleanTitle(node.title)}</title>
            <circle cx={node.x} cy={node.y} r="14" fill="transparent" />
            <circle cx={node.x} cy={node.y} r="6" fill={node.color} />
            {node.label && <text x={node.label.x} y={node.label.y} text-anchor="middle">{node.label.lines.map((line, index) => <tspan x={node.label!.x} dy={index ? 13 : undefined}>{line}</tspan>)}</text>}
          </a>)}
    </g>
  </svg>
  <div class="local-graph-tools">
    {mapUrl && <a href={mapUrl}>생각 지도에서 보기</a>}
  </div>
  {layout.hidden > 0 && <p class="meta">가까운 연결 {layout.nodes.length - 1}개만 그렸습니다. 전체는 아래 목록에 있습니다.</p>}
</div>
<style>
  /* 참조·역참조와 같은 블록이다. 위 선은 사이드바가 긋고, 제목 모양은 site.css의 .list-block이 준다.
     여백은 사이드바의 블록 여백(20px)과 같게 두고, 목록 블록의 아래 선은 쓰지 않는다. */
  .local-graph { padding: 20px 0; border-bottom: 0; }
  /* 위아래 이웃의 두 줄 제목은 그림 가장자리까지 오므로, 블록 제목과 아래 링크에서 떨어지게 그림 위아래에 여백을 둔다.
     세로 여백은 블록 제목의 아래 여백(8px)·링크의 위 여백(10px)과 겹쳐 큰 값만 남으므로 그보다 크게 잡는다. */
  .local-graph svg { display: block; width: 100%; height: 190px; margin: 16px 0 18px; overflow: visible; }
  /* 안내 문장은 보조 글자다. 블록 제목에 쓰는 .list-block > .meta 규칙(먹색·굵기 600)을 받지 않게 되돌린다. */
  .local-graph > p.meta { display: block; margin: 8px 0 0; color: var(--muted); font-weight: 400; }
  .local-graph svg:focus, .local-graph svg:focus-visible { outline: none; }
  .edge { stroke: var(--accent); stroke-width: 1.2; stroke-opacity: .75; }
  .edge.is-in { stroke-dasharray: 5 4; }
  .node circle { stroke: var(--paper); stroke-width: 2.5; }
  .node .ring { fill: none; stroke: var(--accent); stroke-width: 1.2; stroke-opacity: .65; }
  /* 작은 그래프의 이름은 SVG 좌표 안에서 px 기준으로 배치하므로 역할 토큰(rem)을 쓰지 않는다. */
  .node text { font-family: var(--sans); font-size: 11px; fill: var(--ink); paint-order: stroke; stroke: var(--paper); stroke-width: 3.5px; stroke-linejoin: round; pointer-events: none; }
  .node.is-current text { font-weight: 600; }
  a.node { cursor: pointer; outline: none; }
  a.node:focus-visible circle:last-of-type { stroke: var(--accent); }
  @media (hover: hover) { a.node:hover circle:last-of-type { stroke: var(--accent); } }
  /* 목록의 같은 줄에 마우스를 올리거나 포커스하면 노드도 강조한다. 지도처럼 점 테두리만 바꾼다.
     누르는 원(14px)에 판을 깔았더니 제목 자리가 점 반지름 기준이라 판이 이웃 제목을 4~5px 덮었다. */
  a.node.is-linked circle:last-of-type { stroke: var(--accent); }
  .local-graph-tools { display: flex; align-items: center; gap: 6px; margin-top: 10px; }
  .local-graph-tools a { font-size: var(--t-meta); }
</style>
<script src="../scripts/local-graph.ts"></script>
