---
// 글꼴은 자체 호스팅한다. fonts.css는 scripts/vendor-fonts.ts가 만든 @font-face 목록이고 파일은 public/fonts/에 있다.
import '../styles/fonts.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Seal from '../components/Seal.astro';
import Contacts from '../components/Contacts.astro';
import { inlineJson, withBase, topicColorCss } from '../lib/format.ts';
import { SITE_TITLE } from '../lib/site-meta.ts';
import { FEED_LINKS } from '../lib/feeds.ts';
import { structuredData } from '../lib/seo.ts';
import siteConfig from '../../config.json';
import { PALETTE, DARK_PALETTE } from '../lib/palette.ts';
import { getGarden } from '../lib/get-garden.ts';
interface Props { title: string; description: string; path: string; active?: string; ogType?: string; ogImage?: string | null; kind?: string | null; pageType?: string | null; published?: string | null; updated?: string | null; footer?: boolean }
const umami = siteConfig.analytics?.umami?.websiteId ? siteConfig.analytics.umami : null;
// Search Console 소유권 확인 토큰. 공개되는 값이고, 지우면 소유권이 풀리므로 확인 뒤에도 남긴다.
const googleSiteVerification = siteConfig.googleSiteVerification ?? '';
const naverSiteVerification = siteConfig.naverSiteVerification ?? '';
const { title, description, path, active = '', ogType = 'website', ogImage: ogImagePath = null, kind = null, pageType = null, published = null, updated = null, footer = true } = Astro.props;
const siteName = 'TaeZ';
const fullTitle = path === '/' ? SITE_TITLE : `${title} · ${siteName}`;
// 푸터에서는 인장이 이름의 첫 어절을 대신한다. 상수를 쪼개서 쓰므로 제목을 바꿔도 인장이 읽는 말과 남은 문구가 어긋나지 않는다.
const [sealLabel, ...restOfTitle] = SITE_TITLE.split(' ');
// 바닥글의 프로필 아이콘은 홈 소개와 같은 줄(Contacts)이다. 같은 설정을 조립 결과에서 읽는다.
const contacts = footer ? (await getGarden()).home.contacts : [];
const canonical = new URL(withBase(path), Astro.site).href;
const ogImage = new URL(ogImagePath ?? withBase('/og/site.png'), Astro.site).href;
// 구조화 데이터는 페이지가 이미 가진 값만 쓴다. 홈은 WebSite, 노트는 글 종류별 Article, 나머지는 WebPage다. 페이지별 하위 타입은 호출부가 지정한다.
const home = new URL(withBase('/'), Astro.site).href;
const sameAs = (siteConfig.home?.contacts ?? []).map((contact) => contact.url).filter(Boolean);
const jsonLd = inlineJson(structuredData({ ogType, kind, pageType, title: path === '/' ? SITE_TITLE : title, description, url: canonical, image: ogImage, published, updated, siteTitle: SITE_TITLE, siteUrl: home, sameAs }));
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="TaeZ" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {naverSiteVerification && <meta name="naver-site-verification" content={naverSiteVerification} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={path === '/' ? SITE_TITLE : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && updated && <meta property="article:modified_time" content={updated} />}
    <script type="application/ld+json" is:inline set:html={jsonLd}></script>
    <meta name="twitter:card" content="summary_large_image" />
    {/* 주제색 변수. 그래프·주제 점이 var(--topic-…)로 읽어 화면 모드에 따라 바뀐다. */}
    <style is:inline set:html={topicColorCss()}></style>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={PALETTE.paper} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={DARK_PALETTE.paper} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {FEED_LINKS.map((feed) => <link rel="alternate" type="application/rss+xml" title={feed.title} href={new URL(withBase(feed.path), Astro.site).href} />)}
    {umami && <script is:inline defer src={umami.src} data-website-id={umami.websiteId} data-domains={(umami.domains ?? []).join(',')}></script>}
  </head>
  <body>
    <a class="skip-link" href="#app">본문으로 건너뛰기</a>
    <Header active={active} />
    <SearchDialog />
    <main id="app" tabindex="-1"><slot /></main>
    {/* 모든 페이지 끝의 같은 한 줄. 다른 곳의 프로필, 사이트 소개, <head>에만 있던 RSS로 가는 길을 사람에게도 보인다.
       노트 끝 줄에는 소개 링크를 두지 않는다. 화면 높이에 맞춰 그리는 지도 페이지는 바닥글이 붙으면 페이지 스크롤이 생기므로 footer={false}로 뺀다. */}
    {footer && <footer class="site-footer">
      <div class="wrap">
        <span class="site-name"><Seal label={sealLabel} />{restOfTitle.join(' ')}</span>
        <Contacts contacts={contacts} />
        <nav aria-label="사이트 정보"><a href={withBase('/about/')}>이 위키에 대해</a><a href={withBase('/rss.xml')}>RSS</a></nav>
      </div>
    </footer>}
  </body>
</html>
