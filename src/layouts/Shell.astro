---
import '../styles/site.css';
import Header from '../components/Header.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { inlineJson, withBase } from '../lib/format.ts';
import { SITE_TITLE } from '../lib/site-meta.ts';
import { FEED_LINKS } from '../lib/feeds.ts';
import { structuredData } from '../lib/seo.ts';
import siteConfig from '../../config.json';
interface Props { title: string; description: string; path: string; active?: string; ogType?: string; ogImage?: string | null; kind?: string | null; pageType?: string | null; published?: string | null; updated?: string | null }
const umami = siteConfig.analytics?.umami?.websiteId ? siteConfig.analytics.umami : null;
// Search Console 소유권 확인 토큰. 공개되는 값이고, 지우면 소유권이 풀리므로 확인 뒤에도 남긴다.
const googleSiteVerification = siteConfig.googleSiteVerification ?? '';
const naverSiteVerification = siteConfig.naverSiteVerification ?? '';
const { title, description, path, active = '', ogType = 'website', ogImage: ogImagePath = null, kind = null, pageType = null, published = null, updated = null } = Astro.props;
const siteName = 'TaeZ';
const fullTitle = path === '/' ? SITE_TITLE : `${title} · ${siteName}`;
const canonical = new URL(withBase(path), Astro.site).href;
const ogImage = new URL(ogImagePath ?? withBase('/og/site.png'), Astro.site).href;
// 구조화 데이터는 페이지가 이미 가진 값만 쓴다. 홈은 WebSite, 노트는 글 종류별 Article, 나머지는 WebPage다. 페이지별 하위 타입은 호출부가 지정한다.
const home = new URL(withBase('/'), Astro.site).href;
const sameAs = (siteConfig.home?.contacts ?? []).map((contact) => contact.url).filter(Boolean);
const jsonLd = inlineJson(structuredData({ ogType, kind, pageType, title: path === '/' ? SITE_TITLE : title, description, url: canonical, image: ogImage, published, updated, siteTitle: SITE_TITLE, siteUrl: home, sameAs }));
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="TaeZ" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {naverSiteVerification && <meta name="naver-site-verification" content={naverSiteVerification} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={path === '/' ? SITE_TITLE : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && updated && <meta property="article:modified_time" content={updated} />}
    <script type="application/ld+json" is:inline set:html={jsonLd}></script>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f7f2" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {FEED_LINKS.map((feed) => <link rel="alternate" type="application/rss+xml" title={feed.title} href={new URL(withBase(feed.path), Astro.site).href} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {umami && <script is:inline defer src={umami.src} data-website-id={umami.websiteId} data-domains={(umami.domains ?? []).join(',')}></script>}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <a class="skip-link" href="#app">본문으로 건너뛰기</a>
    <Header active={active} />
    <SearchDialog />
    <main id="app" tabindex="-1"><slot /></main>
  </body>
</html>
